     return node(name, properties, children)
 
 
+def dram_span(root):
+    """(dram-base, dram-size, banks) for /chosen from the hardware DTS memory nodes.
+
+    XNU's dram-base/dram-size are "the actual DRAM base address and size as reported by iBoot" (osfmk/arm/arm_init.c):
+    gDramBase/gDramSize, read only by is_dram_addr() to pick the memory attribute of a device (WIMG_IO/POSTED) mapping. The
+    memory the kernel manages is gPhysBase/gPhysSize, the DarwinBoot window from boot_args. A board whose DRAM is several
+    banks (pipa: a bootloader-reserved hole between two) therefore hands XNU the span from the first bank's base to the last
+    bank's end; the banks themselves stay separate here and nothing in the gaps is ever given to the kernel as memory.
+    One node with one range is the single-bank case."""
+    memory = [entry for entry in root.children if entry.strings('device_type') == ['memory'] and entry.enabled()]
+    banks = sorted(r for entry in memory for r in registers(entry))
+    if not banks:
+        raise Error('ADT handoff requires a DRAM range')
+    for base, size in banks:
+        if size == 0 or base + size > 1 << 64:
+            raise Error(f'DRAM bank {base:#x}+{size:#x} is empty or wraps')
+    for (base, size), (following, _) in zip(banks, banks[1:]):
+        if base + size > following:
+            raise Error(f'DRAM banks overlap at {following:#x}')
+    dram_base = banks[0][0]
+    return dram_base, banks[-1][0] + banks[-1][1] - dram_base, banks
+
+
