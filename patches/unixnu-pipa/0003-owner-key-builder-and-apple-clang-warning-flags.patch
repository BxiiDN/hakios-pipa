diff --git a/scripts/build-verified-root-key.py b/scripts/build-verified-root-key.py
new file mode 100755
index 0000000..678051d
--- /dev/null
+++ b/scripts/build-verified-root-key.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Link the owner's VerifiedRoot trust anchor into libVerifiedRootKey.a (CONFIG_XNU_VERIFIED_ROOT_ARCHIVE).
+
+The pipa port's board.toml calls this builder, but no public repository has it (hakios-pipa docs/XNU-BUILD.md). This
+one follows the contract the rest of the tree reads: VerifiedRoot's anchor is b'VROOTKEY' + the 384-byte modulus +
+the exponent 65537 (kits/VerifiedRoot/tools/manifest.py public_anchor, VR_KEY_BYTES 395), and the kernel links it as
+the constant _verified_root_key (scripts/check-verified-block-checkpoints.py, check-owner-root-checkpoints.py).
+
+Inputs, never from the repository:
+  UNIXNU_OWNER_PUBLIC_KEY  PEM public half of the owner's RSA-3072 key (the private half stays with the owner and
+                           signs the root policies; this builder never reads it)
+  UNIXNU_OWNER_KEY_SHA256  sha256 of the 395-byte anchor the build must carry (or --pin); a mismatch stops the build
+  UNIXNU_OWNER_KEY_KIND    "owner" (default) or "ephemeral": a CI key made for one run, so the kernel can be
+                           compiled, linked and prelinked; it authorizes no root and the result is never a boot image
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+parser.add_argument('--pin', help='sha256 of the anchor (default: $UNIXNU_OWNER_KEY_SHA256)')
+args = parser.parse_args()
+
+public = os.environ.get('UNIXNU_OWNER_PUBLIC_KEY')
+if not public or not Path(public).is_file():
+    raise SystemExit('UNIXNU_OWNER_PUBLIC_KEY must name the owner public key (PEM, RSA-3072); see hakios-pipa '
+                     'docs/OWNER-KEY.md')
+pins = {p.lower() for p in (args.pin, os.environ.get('UNIXNU_OWNER_KEY_SHA256')) if p}
+if not pins:
+    raise SystemExit('No pin: pass --pin or set UNIXNU_OWNER_KEY_SHA256 to the anchor digest of the intended key')
+kind = os.environ.get('UNIXNU_OWNER_KEY_KIND', 'owner')
+if kind not in ('owner', 'ephemeral'):
+    raise SystemExit(f'UNIXNU_OWNER_KEY_KIND={kind!r}: expected owner or ephemeral')
+
+spec = importlib.util.spec_from_file_location('vr_manifest', ROOT / 'kits/VerifiedRoot/tools/manifest.py')
+manifest = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(manifest)
+anchor = manifest.public_anchor(Path(public))
+if len(anchor) != 395:
+    raise SystemExit(f'anchor is {len(anchor)} bytes, VerifiedRoot expects 395')
+digest = hashlib.sha256(anchor).hexdigest()
+if digest not in pins:
+    raise SystemExit(f'owner key anchor sha256 {digest} is not the pinned {" / ".join(sorted(pins))}')
+
+out = ROOT / 'build/verified-root-key'
+out.mkdir(parents=True, exist_ok=True)
+(out / 'trusted-key.bin').write_bytes(anchor)
+assembly = out / 'key.S'
+assembly.write_text('// Generated: VerifiedRoot owner trust anchor (public key only)\n'
+                    '.section __DATA_CONST,__const\n.balign 8\n.globl _verified_root_key\n_verified_root_key:\n'
+                    f'.incbin "{out / "trusted-key.bin"}"\n')
+obj = out / 'key.o'
+if shutil.which('xcrun') and subprocess.run(['xcrun', '--sdk', 'iphoneos', '--show-sdk-path'],
+                                            capture_output=True).returncode == 0:
+    sdk = subprocess.check_output(['xcrun', '--sdk', 'iphoneos', '--show-sdk-path'], text=True).strip()
+    compiler = ['xcrun', 'clang', '-isysroot', sdk]
+    ar = ['xcrun', 'ar']
+else:   # Linux toolchain (scripts/unixnu/kernel.py linux_env)
+    compiler = [os.environ.get('CROSS_CLANG', 'clang')]
+    ar = [shutil.which('llvm-ar') or 'ar']
+subprocess.run([*compiler, '-target', 'arm64-apple-ios17.0', '-c', str(assembly), '-o', str(obj)], check=True)
+data = obj.read_bytes()
+if struct.unpack_from('<4I', data) != (0xfeedfacf, 0x100000c, 0, 1):
+    raise SystemExit('key object is not an ordinary ARM64 Mach-O object')
+archive = out / 'libVerifiedRootKey.a'
+archive.unlink(missing_ok=True)
+subprocess.run([*ar, 'rcs', str(archive), str(obj)], check=True)
+(out / 'key.json').write_text(json.dumps(dict(
+    anchor_sha256=digest, anchor_bytes=len(anchor), kind=kind, symbol='_verified_root_key',
+    archive_sha256=hashlib.sha256(archive.read_bytes()).hexdigest(),
+    boot_candidate=kind == 'owner'), indent=2) + '\n')
+print(f'libVerifiedRootKey.a: {kind} anchor {digest}')
