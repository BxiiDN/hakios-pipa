diff --git a/package/UniXNUPkg/Driver/GptViewDxe/GptScan.h b/package/UniXNUPkg/Driver/GptViewDxe/GptScan.h
new file mode 100644
index 0000000..36ce98d
--- /dev/null
+++ b/package/UniXNUPkg/Driver/GptViewDxe/GptScan.h
@@ -0,0 +1,95 @@
+/** @file
+  Read-only GPT survey of one disk, from buffers the caller has already read: the primary header (LBA 1), its partition
+  entry array and the backup header (the disk's last LBA). Pure C with no firmware calls, so the same file is built into
+  GptViewDxe and into the host tests of hakios-pipa (tests/test_gpt_view.py). Nothing here writes anywhere but the
+  caller's summary structure.
+
+  Copyright (c) 2026, hakios-pipa contributors.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef GPT_SCAN_H_
+#define GPT_SCAN_H_
+
+#ifdef GPT_SCAN_HOST
+#include <stdint.h>
+typedef uint8_t   GS_U8;
+typedef uint16_t  GS_U16;
+typedef uint32_t  GS_U32;
+typedef uint64_t  GS_U64;
+#else
+#include <Uefi.h>
+typedef UINT8   GS_U8;
+typedef UINT16  GS_U16;
+typedef UINT32  GS_U32;
+typedef UINT64  GS_U64;
+#endif
+
+#define GPT_SCAN_MAX_ENTRIES  256
+#define GPT_SCAN_NAME_CHARS   36
+
+// Results, one bit each; GPT_SCAN_OK when the primary table is usable.
+#define GPT_SCAN_OK                  0u
+#define GPT_SCAN_NO_SIGNATURE        (1u << 0)   // LBA 1 is not "EFI PART": no GPT on this disk
+#define GPT_SCAN_BAD_HEADER          (1u << 1)   // header size, CRC32 or geometry out of range
+#define GPT_SCAN_BAD_ENTRIES         (1u << 2)   // entry array CRC32 does not match
+#define GPT_SCAN_BAD_BACKUP          (1u << 3)   // backup header missing, CRC wrong, or not the mirror of the primary
+#define GPT_SCAN_BACKUP_NOT_AT_END   (1u << 4)   // primary names a backup LBA other than the disk's last LBA
+#define GPT_SCAN_OVERLAP             (1u << 5)   // two partitions overlap, or one lies outside the usable area
+
+typedef GS_U32 (*GPT_SCAN_CRC32)(const void *Data, GS_U64 Length);
+
+typedef struct {
+  GS_U32  Flags;
+  GS_U32  BlockSize;
+  GS_U64  DiskBlocks;                  // last LBA + 1
+  GS_U64  FirstUsable;
+  GS_U64  LastUsable;
+  GS_U64  BackupLba;
+  GS_U64  EntriesLba;
+  GS_U32  EntryCount;
+  GS_U32  EntrySize;
+  GS_U32  EntriesCrcExpected;          // primary header field at offset 88
+  GS_U32  Partitions;                  // non-empty entries
+  int     HasUserdata;                 // a partition named "userdata": Android's LUN 0 on pipa
+  int     HasIpados;                   // a partition named "ipados"
+  GS_U64  LastPartitionEnd;            // highest last LBA of any partition
+  char    LastPartitionName[GPT_SCAN_NAME_CHARS + 1];
+  GS_U64  FreeBlocks;                  // usable blocks no partition holds
+  GS_U64  LargestFreeFirst;            // the largest such range
+  GS_U64  LargestFreeBlocks;
+  GS_U32  FreeRanges;
+} GPT_SCAN_SUMMARY;
+
+// Primary header from Block (one BlockSize block at LBA 1). Fills the geometry fields of Summary; returns its Flags.
+GS_U32
+GptScanHeader (
+  const GS_U8       *Block,
+  GS_U32            BlockSize,
+  GS_U64            DiskBlocks,
+  GPT_SCAN_CRC32    Crc32,
+  GPT_SCAN_SUMMARY  *Summary
+  );
+
+// The entry array (EntryCount * EntrySize bytes read from EntriesLba) and, if not NULL, the backup header block.
+GS_U32
+GptScanEntries (
+  const GS_U8       *Entries,
+  GS_U64            EntriesBytes,
+  const GS_U8       *BackupBlock,
+  GPT_SCAN_CRC32    Crc32,
+  GPT_SCAN_SUMMARY  *Summary
+  );
+
+// One line of text (NUL-terminated ASCII, at most Cap - 1 characters) for line Index of the summary; returns 0 past the
+// last line. Sizes are in MiB, rounded down.
+int
+GptScanLine (
+  const GPT_SCAN_SUMMARY  *Summary,
+  GS_U64                  NeedBytes,
+  unsigned                Index,
+  char                    *Out,
+  unsigned                Cap
+  );
+
+#endif
diff --git a/package/UniXNUPkg/Driver/GptViewDxe/GptScan.c b/package/UniXNUPkg/Driver/GptViewDxe/GptScan.c
new file mode 100644
index 0000000..5fae416
--- /dev/null
+++ b/package/UniXNUPkg/Driver/GptViewDxe/GptScan.c
@@ -0,0 +1,317 @@
+/** @file
+  Read-only GPT survey (GptScan.h). Byte-order explicit (little endian, as GPT is); no library calls.
+
+  Copyright (c) 2026, hakios-pipa contributors.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "GptScan.h"
+
+static GS_U32 Le32 (const GS_U8 *P) { return (GS_U32)P[0] | (GS_U32)P[1] << 8 | (GS_U32)P[2] << 16 | (GS_U32)P[3] << 24; }
+static GS_U64 Le64 (const GS_U8 *P) { return (GS_U64)Le32 (P) | (GS_U64)Le32 (P + 4) << 32; }
+
+static int
+SameBytes (const GS_U8 *A, const char *B, unsigned N)
+{
+  unsigned  I;
+
+  for (I = 0; I < N; I++) {
+    if (A[I] != (GS_U8)B[I]) {
+      return 0;
+    }
+  }
+  return 1;
+}
+
+// Header CRC32 over HeaderSize bytes with the CRC field taken as zero.
+static GS_U32
+HeaderCrc (const GS_U8 *Block, GS_U32 HeaderSize, GPT_SCAN_CRC32 Crc32)
+{
+  GS_U8   Copy[512];
+  GS_U32  I;
+
+  for (I = 0; I < HeaderSize; I++) {
+    Copy[I] = (I >= 16 && I < 20) ? 0 : Block[I];
+  }
+  return Crc32 (Copy, HeaderSize);
+}
+
+GS_U32
+GptScanHeader (
+  const GS_U8       *Block,
+  GS_U32            BlockSize,
+  GS_U64            DiskBlocks,
+  GPT_SCAN_CRC32    Crc32,
+  GPT_SCAN_SUMMARY  *Summary
+  )
+{
+  GS_U32  HeaderSize;
+  GS_U64  EntryBlocks;
+  GS_U8   *Clear;
+  GS_U32  I;
+
+  Clear = (GS_U8 *)Summary;
+  for (I = 0; I < sizeof (*Summary); I++) {
+    Clear[I] = 0;
+  }
+  Summary->BlockSize  = BlockSize;
+  Summary->DiskBlocks = DiskBlocks;
+  if ((BlockSize < 512) || !SameBytes (Block, "EFI PART", 8)) {
+    Summary->Flags = GPT_SCAN_NO_SIGNATURE;
+    return Summary->Flags;
+  }
+  HeaderSize = Le32 (Block + 12);
+  if ((HeaderSize < 92) || (HeaderSize > 512) || (HeaderSize > BlockSize) ||
+      (HeaderCrc (Block, HeaderSize, Crc32) != Le32 (Block + 16)))
+  {
+    Summary->Flags = GPT_SCAN_BAD_HEADER;
+    return Summary->Flags;
+  }
+  Summary->BackupLba   = Le64 (Block + 32);
+  Summary->FirstUsable = Le64 (Block + 40);
+  Summary->LastUsable  = Le64 (Block + 48);
+  Summary->EntriesLba  = Le64 (Block + 72);
+  Summary->EntryCount  = Le32 (Block + 80);
+  Summary->EntrySize   = Le32 (Block + 84);
+  Summary->EntriesCrcExpected = Le32 (Block + 88);
+  EntryBlocks          = ((GS_U64)Summary->EntryCount * Summary->EntrySize + BlockSize - 1) / BlockSize;
+  if ((Le64 (Block + 24) != 1) || (Summary->EntrySize < 128) || (Summary->EntrySize > 1024) ||
+      (Summary->EntryCount == 0) || (Summary->EntryCount > GPT_SCAN_MAX_ENTRIES) || (Summary->EntriesLba < 2) ||
+      (Summary->EntriesLba + EntryBlocks > Summary->FirstUsable) || (Summary->FirstUsable > Summary->LastUsable) ||
+      (Summary->LastUsable >= DiskBlocks))
+  {
+    Summary->Flags = GPT_SCAN_BAD_HEADER;
+    return Summary->Flags;
+  }
+  if (Summary->BackupLba != DiskBlocks - 1) {
+    Summary->Flags |= GPT_SCAN_BACKUP_NOT_AT_END;
+  }
+  return Summary->Flags;
+}
+
+GS_U32
+GptScanEntries (
+  const GS_U8       *Entries,
+  GS_U64            EntriesBytes,
+  const GS_U8       *BackupBlock,
+  GPT_SCAN_CRC32    Crc32,
+  GPT_SCAN_SUMMARY  *Summary
+  )
+{
+  static GS_U64  First[GPT_SCAN_MAX_ENTRIES];
+  static GS_U64  Last[GPT_SCAN_MAX_ENTRIES];
+  GS_U64         Bytes;
+  GS_U32         Count;
+  GS_U32         I;
+  GS_U32         J;
+  GS_U64         Cursor;
+
+  Bytes = (GS_U64)Summary->EntryCount * Summary->EntrySize;
+  if (EntriesBytes < Bytes) {
+    Summary->Flags |= GPT_SCAN_BAD_ENTRIES;
+    return Summary->Flags;
+  }
+  // primary header field 88: CRC32 of the entry array. A mismatch is reported (the verdict line then says UNKNOWN), but the
+  // entries are still read so the disk can be named.
+  if (Crc32 (Entries, Bytes) != Summary->EntriesCrcExpected) {
+    Summary->Flags |= GPT_SCAN_BAD_ENTRIES;
+  }
+  Count = 0;
+  for (I = 0; I < Summary->EntryCount; I++) {
+    const GS_U8  *E = Entries + (GS_U64)I * Summary->EntrySize;
+    int          Empty = 1;
+    char         Name[GPT_SCAN_NAME_CHARS + 1];
+
+    for (J = 0; J < 16; J++) {
+      if (E[J] != 0) {
+        Empty = 0;
+      }
+    }
+    if (Empty) {
+      continue;
+    }
+    for (J = 0; J < GPT_SCAN_NAME_CHARS; J++) {
+      GS_U16  C = (GS_U16)(E[56 + 2 * J] | E[57 + 2 * J] << 8);
+
+      Name[J] = (C >= 0x20 && C < 0x7f) ? (char)C : (C == 0 ? 0 : '?');
+      if (C == 0) {
+        break;
+      }
+    }
+    Name[J < GPT_SCAN_NAME_CHARS ? J : GPT_SCAN_NAME_CHARS] = 0;
+    First[Count] = Le64 (E + 32);
+    Last[Count]  = Le64 (E + 40);
+    if ((First[Count] > Last[Count]) || (First[Count] < Summary->FirstUsable) || (Last[Count] > Summary->LastUsable)) {
+      Summary->Flags |= GPT_SCAN_OVERLAP;
+    }
+    if (SameBytes ((const GS_U8 *)Name, "userdata", 9)) {
+      Summary->HasUserdata = 1;
+    }
+    if (SameBytes ((const GS_U8 *)Name, "ipados", 7)) {
+      Summary->HasIpados = 1;
+    }
+    if (Last[Count] >= Summary->LastPartitionEnd) {
+      Summary->LastPartitionEnd = Last[Count];
+      for (J = 0; J <= GPT_SCAN_NAME_CHARS; J++) {
+        Summary->LastPartitionName[J] = Name[J];
+        if (Name[J] == 0) {
+          break;
+        }
+      }
+    }
+    Count++;
+  }
+  Summary->Partitions = Count;
+  // insertion sort by first LBA, then the gaps between them inside first..last usable
+  for (I = 1; I < Count; I++) {
+    GS_U64  F = First[I], L = Last[I];
+
+    for (J = I; J > 0 && First[J - 1] > F; J--) {
+      First[J] = First[J - 1];
+      Last[J]  = Last[J - 1];
+    }
+    First[J] = F;
+    Last[J]  = L;
+  }
+  Cursor = Summary->FirstUsable;
+  for (I = 0; I <= Count; I++) {
+    GS_U64  Start = (I < Count) ? First[I] : Summary->LastUsable + 1;
+
+    if ((I > 0) && (I < Count) && (First[I] <= Last[I - 1])) {
+      Summary->Flags |= GPT_SCAN_OVERLAP;
+    }
+    if (Start > Cursor) {
+      GS_U64  Gap = Start - Cursor;
+
+      Summary->FreeBlocks += Gap;
+      Summary->FreeRanges++;
+      if (Gap > Summary->LargestFreeBlocks) {
+        Summary->LargestFreeBlocks = Gap;
+        Summary->LargestFreeFirst  = Cursor;
+      }
+    }
+    if ((I < Count) && (Last[I] + 1 > Cursor)) {
+      Cursor = Last[I] + 1;
+    }
+  }
+  if (BackupBlock != (const GS_U8 *)0) {
+    GS_U32  Size = Le32 (BackupBlock + 12);
+
+    if (!SameBytes (BackupBlock, "EFI PART", 8) || (Size < 92) || (Size > 512) || (Size > Summary->BlockSize) ||
+        (HeaderCrc (BackupBlock, Size, Crc32) != Le32 (BackupBlock + 16)) ||
+        (Le64 (BackupBlock + 24) != Summary->DiskBlocks - 1) || (Le64 (BackupBlock + 32) != 1) ||
+        (Le32 (BackupBlock + 88) != Summary->EntriesCrcExpected) || (Le64 (BackupBlock + 40) != Summary->FirstUsable) ||
+        (Le64 (BackupBlock + 48) != Summary->LastUsable))
+    {
+      Summary->Flags |= GPT_SCAN_BAD_BACKUP;
+    }
+  } else {
+    Summary->Flags |= GPT_SCAN_BAD_BACKUP;
+  }
+  return Summary->Flags;
+}
+
+static unsigned
+PutStr (char *Out, unsigned At, unsigned Cap, const char *S)
+{
+  while (*S && At + 1 < Cap) {
+    Out[At++] = *S++;
+  }
+  Out[At < Cap ? At : Cap - 1] = 0;
+  return At;
+}
+
+static unsigned
+PutNum (char *Out, unsigned At, unsigned Cap, GS_U64 V)
+{
+  char  Buf[24];
+  int   I = 23;
+
+  Buf[I] = 0;
+  do {
+    Buf[--I] = (char)('0' + V % 10);
+    V       /= 10;
+  } while (V && I > 0);
+  return PutStr (Out, At, Cap, Buf + I);
+}
+
+static GS_U64 Mib (const GPT_SCAN_SUMMARY *S, GS_U64 Blocks) { return Blocks * S->BlockSize / (1024 * 1024); }
+
+int
+GptScanLine (
+  const GPT_SCAN_SUMMARY  *S,
+  GS_U64                  NeedBytes,
+  unsigned                Index,
+  char                    *Out,
+  unsigned                Cap
+  )
+{
+  unsigned  At = 0;
+
+  if (Cap == 0) {
+    return 0;
+  }
+  Out[0] = 0;
+  if (S->Flags & (GPT_SCAN_NO_SIGNATURE | GPT_SCAN_BAD_HEADER)) {
+    if (Index > 0) {
+      return 0;
+    }
+    At = PutStr (Out, At, Cap, (S->Flags & GPT_SCAN_NO_SIGNATURE) ? "no GPT, " : "GPT header INVALID, ");
+    At = PutNum (Out, At, Cap, Mib (S, S->DiskBlocks));
+    PutStr (Out, At, Cap, " MiB");
+    return 1;
+  }
+  switch (Index) {
+    case 0:
+      At = PutStr (Out, At, Cap, S->HasUserdata ? "LUN 0 (userdata): " : "disk: ");
+      At = PutNum (Out, At, Cap, Mib (S, S->DiskBlocks));
+      At = PutStr (Out, At, Cap, " MiB, block ");
+      At = PutNum (Out, At, Cap, S->BlockSize);
+      At = PutStr (Out, At, Cap, ", ");
+      At = PutNum (Out, At, Cap, S->Partitions);
+      PutStr (Out, At, Cap, " partitions");
+      return 1;
+    case 1:
+      At = PutStr (Out, At, Cap, "usable LBA ");
+      At = PutNum (Out, At, Cap, S->FirstUsable);
+      At = PutStr (Out, At, Cap, "..");
+      At = PutNum (Out, At, Cap, S->LastUsable);
+      At = PutStr (Out, At, Cap, ", last partition ");
+      At = PutStr (Out, At, Cap, S->LastPartitionName);
+      At = PutStr (Out, At, Cap, " ends ");
+      PutNum (Out, At, Cap, S->LastPartitionEnd);
+      return 1;
+    case 2:
+      At = PutStr (Out, At, Cap, "free ");
+      At = PutNum (Out, At, Cap, Mib (S, S->FreeBlocks));
+      At = PutStr (Out, At, Cap, " MiB in ");
+      At = PutNum (Out, At, Cap, S->FreeRanges);
+      At = PutStr (Out, At, Cap, " range(s), largest ");
+      At = PutNum (Out, At, Cap, Mib (S, S->LargestFreeBlocks));
+      At = PutStr (Out, At, Cap, " MiB at LBA ");
+      PutNum (Out, At, Cap, S->LargestFreeFirst);
+      return 1;
+    case 3:
+      At = PutStr (Out, At, Cap, "checks: entries ");
+      At = PutStr (Out, At, Cap, (S->Flags & GPT_SCAN_BAD_ENTRIES) ? "BAD" : "ok");
+      At = PutStr (Out, At, Cap, ", backup ");
+      At = PutStr (Out, At, Cap, (S->Flags & GPT_SCAN_BAD_BACKUP) ? "BAD" : "ok");
+      At = PutStr (Out, At, Cap, (S->Flags & GPT_SCAN_BACKUP_NOT_AT_END) ? ", backup LBA not at end" : "");
+      PutStr (Out, At, Cap, (S->Flags & GPT_SCAN_OVERLAP) ? ", OVERLAP" : ", no overlap");
+      return 1;
+    case 4:
+      if (!S->HasUserdata) {
+        return 0;
+      }
+      At = PutStr (Out, At, Cap, S->HasIpados ? "ipados: present" : "ipados: absent");
+      At = PutStr (Out, At, Cap, "; need ");
+      At = PutNum (Out, At, Cap, NeedBytes / (1024 * 1024));
+      At = PutStr (Out, At, Cap, " MiB -> ");
+      PutStr (Out, At, Cap, (S->Flags & (GPT_SCAN_BAD_ENTRIES | GPT_SCAN_OVERLAP)) ? "UNKNOWN (table not sound)" :
+                            (S->LargestFreeBlocks * S->BlockSize >= NeedBytes) ? "DESIGN A FITS" :
+                            "no room without resizing userdata");
+      return 1;
+    default:
+      return 0;
+  }
+}
