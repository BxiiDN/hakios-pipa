+backlight_attach_obj = OUT / 'PipaBacklightAttach.o'
+run([str(backlight_attach_source) if str(arg) == str(source) else str(backlight_attach_obj) if str(arg) == str(OUT / 'LegacyDisplayProbe.o') else arg for arg in cmd] + ['-I', str(kit_dir)], cwd=r['directory'])
+backlight_class_source = kit_dir / 'PipaBacklightService.cpp'
+backlight_class_obj = OUT / 'PipaBacklightService.o'
+backlight_class_late = OUT / 'PipaBacklightService.late.o'
