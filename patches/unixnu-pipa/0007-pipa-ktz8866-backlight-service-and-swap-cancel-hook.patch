diff --git a/package/BacklightProbe.c b/package/BacklightProbe.c
new file mode 100644
index 0000000..c7745d3
--- /dev/null
+++ b/package/BacklightProbe.c
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// pipa backlight, step 1 (pipa-bl-probe=1; =2 adds the read-only I2C step 2, =3 the brightness write test 3a): READ-ONLY state of the path to the KTZ8866 backlight controller, which sits at
+// I2C address 0x11 on QUP SE11 (stock dtbo: qupv3_se11_i2c, i2c@a8c000; HWEN gpio139, ENP gpio130, ENN gpio131). Nothing is
+// written anywhere: this logs whether the bootloader left the SE11 clocks on, how the serial engine is set up (protocol, clock
+// divider, SCL counters) and how its pins gpio60/61 are muxed, so the I2C master that comes next follows that state instead of
+// guessed values.
+//
+// Register offsets are those of the Linux v6.12 sources, read for this (no code copied):
+//   drivers/clk/qcom/gcc-sm8250.c   gcc_qupv3_wrap1_s3_clk halt 0x1839c (i2c11 uses GCC_QUPV3_WRAP1_S3_CLK in sm8250.dtsi),
+//                                   wrap_1_m_ahb 0x18004, wrap_1_s_ahb 0x18008, wrap1_core 0x23138, wrap1_core_2x 0x23140,
+//                                   all voted in 0x52008 (bits 25, 20, 21, 19, 18); a branch's CBCR bit 31 is CLK_OFF.
+//   arch/arm64/boot/dts/qcom/sm8250.dtsi   gcc at 0x100000, tlmm "south" tile at 0x0f500000.
+//   drivers/pinctrl/qcom/pinctrl-sm8250.c  gpio60/61 SOUTH, qup11 is function 1; ctl at 0x1000 * n, io at + 4.
+//   include/linux/soc/qcom/geni-se.h, drivers/i2c/busses/i2c-qcom-geni.c   SE register offsets.
+// The SE registers are read only when all five clocks are voted and either running or in hardware clock gating: an access to
+// an unclocked serial engine can abort.
+#include <stdint.h>
+
+extern uint64_t ml_io_map(uint64_t phys_addr, uint64_t size);
+extern int PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_arg);
+extern int kernel_thread_start(void (*continuation)(void *, int), void *parameter, void **new_thread);
+extern void thread_deallocate(void *thread);
+extern void IOSleep(unsigned milliseconds);
+extern int printf(const char *, ...);
+
+#define GCC_BASE 0x00100000ull
+#define TLMM_SOUTH 0x0f500000ull
+#define SE11_BASE 0x00a8c000ull
+
+static uint32_t rd(uint64_t phys) {
+    uint64_t page = ml_io_map(phys & ~0xfffull, 0x1000);
+    if (!page) return 0xdeadbeefu;
+    return *(volatile uint32_t *)(uintptr_t)(page + (phys & 0xfff));
+}
+
+volatile uint32_t native_backlight_probe_state;   // 0 not run, 1 clocks off (SE not read), 2 SE read, 3 KTZ8866 read, 4 I2C failed, 5 write test passed
+static unsigned probe_level;
+
+extern void IODelay(unsigned microseconds);
+
+// ---- step 2 (pipa-bl-probe=2): GENI I2C master in FIFO mode, polled, READS ONLY from the KTZ8866 ----
+// Register semantics from Linux v6.12 include/linux/soc/qcom/geni-se.h, drivers/soc/qcom/qcom-geni-se.c and
+// drivers/i2c/busses/i2c-qcom-geni.c (read for this; no code copied). Values written to the serial engine, all as Linux's
+// probe + qcom_geni_i2c_conf would for a 100 kHz bus (the stock pipa DT sets no clock-frequency on i2c@a8c000; 100 kHz is
+// mainline's default):
+//   GENI_CGC_CTRL 0x28 |= 0x7f, SE_DMA_GENERAL_CFG 0xe30 |= 0xf, GENI_OUTPUT_CTRL 0x24 = 0x7f, GENI_FORCE_DEFAULT 0x20 = 1,
+//   RX watermark 0x810 = depth-1, RX RFR 0x814 = depth, M_IRQ_EN 0x614 |= common errors + CMD_DONE + RX watermark/last,
+//   DMA_MODE_EN 0x258 = 0 (FIFO), packing 8 bits x 4, MSB first: TX/RX_PACKING_CFG0 0x7f8fe, CFG1 0xffefe, BYTE_GRAN 0,
+//   CLK_SEL 0, SER_M_CLK_CFG (7 << 4) | 1, SCL_COUNTERS (10 << 20) | (11 << 10) | 26 (geni_i2c_clk_map, 19.2 MHz source).
+// SE_IRQ_EN (0xe1c, the line to the GIC) is not touched: the transfer is polled. Only proceeds when the wrap1_s3 RCG runs from
+// the 19.2 MHz XO (CFG 0x183a4: SRC_SEL 0, divider bypass/1, no M/N), the engine is idle and protocol 3 (I2C) is loaded.
+#define SE_REG(off) (*(volatile uint32_t *)(uintptr_t)(se + (off)))
+#define KTZ_ADDR 0x11u
+#define I2C_OP_WRITE 1u
+#define I2C_OP_READ 2u
+#define I2C_STOP_STRETCH (1u << 2)
+#define M_CMD_DONE (1u << 0)
+// as geni_i2c_irq: a transfer failed when CMD_OVERRUN/ILLEGAL_CMD/CMD_FAILURE/CMD_ABORT is set; GP_IRQ1/3/4 say why
+#define M_ERRORS ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 5))
+#define M_COMMON_EN (0x7eu | (1u << 22) | (1u << 23) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define M_RX_WM_LAST ((1u << 26) | (1u << 27))
+
+static uint64_t se;
+
+static const char *i2c_error_name(uint32_t st) {
+    if (st & (1u << 10)) return "NACK";
+    if (st & (1u << 12)) return "bus protocol";
+    if (st & (1u << 13)) return "arbitration lost";
+    if (st & (1u << 1)) return "command overrun";
+    if (st & (1u << 2)) return "illegal command";
+    if (st & (1u << 5)) return "aborted";
+    return "failure";
+}
+
+// Waits for CMD_DONE or an error; on error or timeout aborts the command. Returns M_IRQ_STATUS (0 on timeout).
+static uint32_t i2c_wait(uint32_t want, uint8_t *rx) {
+    uint32_t st = 0;
+    for (unsigned us = 0; us < 50000; us += 10) {
+        st = SE_REG(0x610);
+        if (rx && (st & M_RX_WM_LAST) && (SE_REG(0x804) & 0x1ffffffu)) {
+            *rx = (uint8_t)SE_REG(0x780);
+            rx = 0;
+            SE_REG(0x618) = st & M_RX_WM_LAST;
+        }
+        if (st & (want | M_ERRORS)) break;
+        IODelay(10);
+    }
+    if (rx && (SE_REG(0x804) & 0x1ffffffu)) *rx = (uint8_t)SE_REG(0x780);   // data and CMD_DONE seen in the same poll
+    if (!(st & want) || (st & M_ERRORS)) {
+        SE_REG(0x604) = 1u << 1;   // M_GENI_CMD_ABORT
+        for (unsigned us = 0; us < 10000 && !(SE_REG(0x610) & (1u << 5)); us += 10) IODelay(10);
+        SE_REG(0x618) = 0xffffffffu;
+        return st ? st : 0;
+    }
+    SE_REG(0x618) = st;
+    return st;
+}
+
+// One register read: write the register number without STOP, then a repeated-start read of one byte.
+static int ktz_read(uint8_t reg, uint8_t *value) {
+    SE_REG(0x618) = 0xffffffffu;
+    SE_REG(0x26c) = 1;   // SE_I2C_TX_TRANS_LEN
+    SE_REG(0x600) = (I2C_OP_WRITE << 27) | (KTZ_ADDR << 9) | I2C_STOP_STRETCH;
+    SE_REG(0x700) = reg;
+    uint32_t st = i2c_wait(M_CMD_DONE, 0);
+    if (!(st & M_CMD_DONE) || (st & M_ERRORS)) {
+        printf("[blprobe] i2c write reg 0x%02x: %s (m_irq 0x%08x, geni_status 0x%08x)\n", reg,
+               st ? i2c_error_name(st) : "timeout", st, SE_REG(0x40));
+        return -1;
+    }
+    uint8_t byte = 0xff;
+    SE_REG(0x270) = 1;   // SE_I2C_RX_TRANS_LEN
+    SE_REG(0x600) = (I2C_OP_READ << 27) | (KTZ_ADDR << 9);
+    st = i2c_wait(M_CMD_DONE, &byte);
+    if (!(st & M_CMD_DONE) || (st & M_ERRORS)) {
+        printf("[blprobe] i2c read reg 0x%02x: %s (m_irq 0x%08x)\n", reg, st ? i2c_error_name(st) : "timeout", st);
+        return -1;
+    }
+    *value = byte;
+    return 0;
+}
+
+// One register write (register number, value) in a single 2-byte write with STOP.
+static int ktz_write(uint8_t reg, uint8_t value) {
+    SE_REG(0x618) = 0xffffffffu;
+    SE_REG(0x26c) = 2;
+    SE_REG(0x600) = (I2C_OP_WRITE << 27) | (KTZ_ADDR << 9);
+    SE_REG(0x700) = (uint32_t)reg | ((uint32_t)value << 8);
+    uint32_t st = i2c_wait(M_CMD_DONE, 0);
+    if (!(st & M_CMD_DONE) || (st & M_ERRORS)) {
+        printf("[blprobe] i2c write 0x%02x=0x%02x: %s (m_irq 0x%08x)\n", reg, value, st ? i2c_error_name(st) : "timeout", st);
+        return -1;
+    }
+    return 0;
+}
+
+// 11-bit level as mainline ktz8866_backlight_update_status: LSB register bits 2:0 first, then MSB register bits 10:3.
+static int ktz_set_level(unsigned level) {
+    if (level > 2047) level = 2047;
+    if (ktz_write(0x04, level & 7) || ktz_write(0x05, (level >> 3) & 0xff)) return -1;
+    uint8_t lsb = 0, msb = 0;
+    if (ktz_read(0x04, &lsb) || ktz_read(0x05, &msb)) return -1;
+    unsigned back = ((unsigned)msb << 3) | (lsb & 7);
+    printf("[blprobe] ktz8866 level set %u, read back %u %s\n", level, back, back == level ? "OK" : "MISMATCH");
+    return back == level ? 0 : -1;
+}
+
+static int ktz_open_locked(int log);
+
+static void i2c_step2(void) {
+    if (ktz_open_locked(1)) return;
+    static const struct { uint8_t reg; const char *name; } regs[] = {
+        {0x01, "DEVICE_ID"}, {0x02, "BL_CFG1"}, {0x03, "BL_CFG2"}, {0x04, "BL_BRT_LSB"}, {0x05, "BL_BRT_MSB"},
+        {0x08, "BL_EN"}, {0x0f, "FLAG"},
+    };
+    uint8_t v[7] = {0};
+    for (unsigned i = 0; i < 7; ++i) {
+        if (ktz_read(regs[i].reg, &v[i])) { native_backlight_probe_state = 4; return; }
+        printf("[blprobe] ktz8866 %s (0x%02x) = 0x%02x\n", regs[i].name, regs[i].reg, v[i]);
+    }
+    // 11-bit level: LSB register bits 2:0, MSB register = bits 10:3 (mainline ktz8866_backlight_update_status)
+    printf("[blprobe] ktz8866 level %u of 2047, BL_EN 0x%02x\n", ((unsigned)v[4] << 3) | (v[3] & 7), v[5]);
+    native_backlight_probe_state = 3;
+    if (probe_level < 3) return;
+    // step 3a (pipa-bl-probe=3): brightness registers only, 1009 -> 400 for 5 s -> the level the bootloader left
+    unsigned original = ((unsigned)v[4] << 3) | (v[3] & 7);
+    if (!original || ktz_set_level(400)) { native_backlight_probe_state = 4; return; }
+    IOSleep(5000);
+    if (ktz_set_level(original)) { native_backlight_probe_state = 4; return; }
+    native_backlight_probe_state = 5;
+}
+
+// Clock, source-clock, pin and engine checks, then the I2C set-up. Returns 0 when SE11 is ready for transfers.
+static int ktz_open_locked(int log) {
+    static int opened;
+    if (opened) return opened > 0 ? 0 : -1;
+    opened = -1;
+    static const struct { uint32_t offset, vote_bit; } clk[] = {{0x1839c, 25}, {0x18004, 20}, {0x18008, 21}, {0x23138, 19}, {0x23140, 18}};
+    uint32_t vote = rd(GCC_BASE + 0x52008);
+    for (unsigned i = 0; i < 5; ++i) {
+        uint32_t cbcr = rd(GCC_BASE + clk[i].offset);
+        if (vote == 0xdeadbeefu || cbcr == 0xdeadbeefu || !((vote >> clk[i].vote_bit) & 1) || (((cbcr >> 31) & 1) && !((cbcr >> 1) & 1))) {
+            printf("[blprobe] SE11 clock 0x%x not usable (cbcr 0x%08x vote 0x%08x)\n", clk[i].offset, cbcr, vote);
+            return -1;
+        }
+    }
+    uint32_t rcg_cmd = rd(GCC_BASE + 0x183a0), rcg_cfg = rd(GCC_BASE + 0x183a4);
+    uint32_t src = (rcg_cfg >> 8) & 7, div = rcg_cfg & 0x1f, mode = (rcg_cfg >> 12) & 3;
+    if (log) printf("[blprobe] s3 rcg cmd 0x%08x cfg 0x%08x (src %u div %u mode %u)\n", rcg_cmd, rcg_cfg, src, div, mode);
+    if ((rcg_cmd >> 31) & 1 || src != 0 || div > 1 || mode != 0) {
+        printf("[blprobe] step 2 skipped: SE11 source clock is not the 19.2 MHz XO\n");
+        return -1;
+    }
+    static const struct { const char *name; uint64_t base; unsigned gpio; } pins[] = {
+        {"HWEN", 0x0f100000ull, 139}, {"ENP", TLMM_SOUTH, 130}, {"ENN", TLMM_SOUTH, 131},
+    };
+    for (unsigned i = 0; log && i < 3; ++i) {
+        uint32_t ctl = rd(pins[i].base + 0x1000ull * pins[i].gpio), io = rd(pins[i].base + 0x1000ull * pins[i].gpio + 4);
+        printf("[blprobe] %s gpio%u ctl 0x%08x (func %u, oe %u) in %u out %u\n", pins[i].name, pins[i].gpio, ctl,
+               (ctl >> 2) & 0xf, (ctl >> 9) & 1, io & 1, (io >> 1) & 1);
+    }
+    se = ml_io_map(SE11_BASE, 0x1000);
+    if (!se) return -1;
+    if (SE_REG(0x40) & 1u) {
+        printf("[blprobe] step 2 skipped: SE11 primary sequencer busy (status 0x%08x)\n", SE_REG(0x40));
+        return -1;
+    }
+    uint32_t depth = (SE_REG(0xe24) >> 16) & 0x3f;
+    SE_REG(0x28) |= 0x7fu;
+    SE_REG(0xe30) |= 0xfu;
+    SE_REG(0x24) = 0x7fu;
+    SE_REG(0x20) = 1u;
+    SE_REG(0x618) = 0xffffffffu;
+    SE_REG(0x810) = depth - 1;
+    SE_REG(0x814) = depth;
+    if (log) printf("[blprobe] se11 before: SE_IRQ_EN 0x%08x M_IRQ_EN 0x%08x CGC 0x%08x\n", SE_REG(0xe1c), SE_REG(0x614), SE_REG(0x28));
+    SE_REG(0x614) |= M_COMMON_EN | M_CMD_DONE | M_RX_WM_LAST;
+    SE_REG(0x258) = 0;
+    SE_REG(0x80c) = 0;   // no TX watermark: the single byte is written right after the command
+    SE_REG(0x260) = 0x7f8feu; SE_REG(0x264) = 0xffefeu; SE_REG(0x284) = 0x7f8feu; SE_REG(0x288) = 0xffefeu;
+    SE_REG(0x254) = 0;
+    SE_REG(0x7c) = 0;
+    SE_REG(0x48) = (7u << 4) | 1u;
+    SE_REG(0x278) = (10u << 20) | (11u << 10) | 26u;
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (log) printf("[blprobe] se11 i2c ready: fifo depth %u, m_clk 0x%08x, scl 0x%08x, m_irq_en 0x%08x\n", depth, SE_REG(0x48),
+           SE_REG(0x278), SE_REG(0x614));
+    opened = 1;
+    return 0;
+}
+
+// For the AppleARMBacklight service (PipaBacklight.cpp). Callers serialise; each returns 0 on success.
+int pipa_ktz_open(unsigned *level) {
+    if (ktz_open_locked(0)) return -1;
+    uint8_t lsb = 0, msb = 0;
+    if (ktz_read(0x04, &lsb) || ktz_read(0x05, &msb)) return -1;
+    if (level) *level = ((unsigned)msb << 3) | (lsb & 7);
+    return 0;
+}
+
+int pipa_ktz_read_level(unsigned *level) {
+    uint8_t lsb = 0, msb = 0;
+    if (ktz_read(0x04, &lsb) || ktz_read(0x05, &msb)) return -1;
+    *level = ((unsigned)msb << 3) | (lsb & 7);
+    return 0;
+}
+
+int pipa_ktz_write_level(unsigned level) {
+    if (level > 2047) level = 2047;
+    return ktz_write(0x04, level & 7) || ktz_write(0x05, (level >> 3) & 0xff) ? -1 : 0;
+}
+
+static void probe_thread(void *arg, int wait) {
+    (void)arg; (void)wait;
+    IOSleep(20000);
+    static const struct { const char *name; uint32_t offset, vote_bit; } clocks[] = {
+        {"wrap1_s3", 0x1839c, 25}, {"wrap1_m_ahb", 0x18004, 20}, {"wrap1_s_ahb", 0x18008, 21}, {"wrap1_core", 0x23138, 19},
+        {"wrap1_core_2x", 0x23140, 18},
+    };
+    // A branch whose CBCR has HW_CTL (bit 1) set is in hardware clock gating: the hardware ungates it on each bus access and
+    // CLK_OFF (bit 31) only says it is idle at this moment. Linux (clk-branch.c, branch_in_hwcg_mode) skips the halt check
+    // for such branches; it is usable when its vote is set. Test 24v: wrap1_s_ahb read 0x80000002 with vote bit 21 set.
+    uint32_t vote = rd(GCC_BASE + 0x52008);
+    printf("[blprobe] gcc vote 0x52008 = 0x%08x\n", vote);
+    int all_on = vote != 0xdeadbeefu;
+    for (unsigned i = 0; i < sizeof clocks / sizeof clocks[0]; ++i) {
+        uint32_t cbcr = rd(GCC_BASE + clocks[i].offset);
+        int voted = (vote >> clocks[i].vote_bit) & 1, hwcg = (cbcr >> 1) & 1, off = (cbcr >> 31) & 1;
+        int usable = cbcr != 0xdeadbeefu && voted && (!off || hwcg);
+        if (!usable) all_on = 0;
+        printf("[blprobe] gcc %s cbcr 0x%08x vote %d hwcg %d %s\n", clocks[i].name, cbcr, voted, hwcg,
+               !usable ? "OFF" : off ? "gated-idle" : "on");
+    }
+    for (unsigned gpio = 60; gpio <= 61; ++gpio) {
+        uint32_t ctl = rd(TLMM_SOUTH + 0x1000ull * gpio), io = rd(TLMM_SOUTH + 0x1000ull * gpio + 4);
+        printf("[blprobe] gpio%u ctl 0x%08x (func %u) io 0x%08x\n", gpio, ctl, (ctl >> 2) & 0xf, io);
+    }
+    if (!all_on) {
+        native_backlight_probe_state = 1;
+        printf("[blprobe] SE11 not read: a clock is off\n");
+        return;
+    }
+    static const struct { const char *name; uint32_t offset; } se[] = {
+        {"FW_REVISION_RO", 0x68}, {"IF_DISABLE_RO", 0x64}, {"GENI_STATUS", 0x40}, {"SER_M_CLK_CFG", 0x48}, {"CLK_SEL", 0x7c},
+        {"DMA_MODE_EN", 0x258}, {"I2C_SCL_COUNTERS", 0x278}, {"M_IRQ_STATUS", 0x610}, {"TX_FIFO_STATUS", 0x800},
+        {"RX_FIFO_STATUS", 0x804}, {"HW_PARAM_0", 0xe24},
+    };
+    for (unsigned i = 0; i < sizeof se / sizeof se[0]; ++i) {
+        uint32_t v = rd(SE11_BASE + se[i].offset);
+        if (se[i].offset == 0x68) printf("[blprobe] se11 %s 0x%08x (protocol %u, 3 = I2C)\n", se[i].name, v, (v >> 8) & 0xff);
+        else printf("[blprobe] se11 %s 0x%08x\n", se[i].name, v);
+    }
+    native_backlight_probe_state = 2;
+    if (probe_level >= 2) i2c_step2();
+}
+
+void native_backlight_probe(void) {
+    static int started;
+    unsigned on = 0;
+    if (started || !PE_parse_boot_argn("pipa-bl-probe", &on, sizeof on) || on < 1 || on > 3) return;
+    probe_level = on;
+    started = 1;
+    void *thread = 0;
+    if (kernel_thread_start(probe_thread, 0, &thread) == 0) thread_deallocate(thread);
+}
diff --git a/package/LegacyDisplayProbe.cpp b/package/LegacyDisplayProbe.cpp
index af9fbd9..0651a0a 100644
--- a/package/LegacyDisplayProbe.cpp
