diff --git a/board.toml b/board.toml
index cfb78d2..203c7de 100644
--- a/board.toml
+++ b/board.toml
@@ -206,7 +206,7 @@ size_mib = 192
 loader = "firmware"
 title = "Xiaomi Pad 6 (iPadOS 17.7.11)"
 dram_size = "0x200000000"
-timeout = 3
+timeout = 10
 kernel_args = [
   "-v",
   "serial=3",
@@ -273,6 +273,13 @@ confirm = "ERASE all iPadOS user data and install again?"
 confirm_titles = ["Erase Data, skip Hello, boot", "Erase Data, show Hello, boot"]
 confirm_args = ["sheng-data-reset=1", "sheng-data-reset=2"]
 
+
+# Dual boot with Android (hakios-pipa patches/unixnu/0001): Android first and default, so the 10 s countdown ends in
+# Android; iPadOS is chosen with the volume keys and Power. Every entry other than iPadOS is a reset: this image is
+# only ever RAM-booted (fastboot boot), so the stock bootloader starts Android again.
+[payload.dualboot]
+android_title = "Android / HyperOS"
+recovery_title = "Recovery or Fastboot (hold Vol+ or Vol- while it restarts)"
 [payload.adt]
 chip_id = "8011"
 unique_chip_id = "required"
