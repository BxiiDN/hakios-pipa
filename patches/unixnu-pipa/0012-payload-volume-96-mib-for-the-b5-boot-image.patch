diff --git a/board.toml b/board.toml
--- a/board.toml
+++ b/board.toml
@@ -212,7 +212,10 @@
 # 128, not 192: the boot image is this volume + the firmware (~3 MiB) + headers. With 192 it is 204 132 352 bytes, above
 # the 8 GB unit's boot_b (0xC000000 = 201 326 592, fastboot getvar 2026-11-16); ABL refuses a boot image larger than the
 # partition even for `fastboot boot` and then marks the slot unbootable. The payload uses ~66 MB (session 10).
-size_mib = 128
+# 96, not 128 (hakios-pipa session 19, docs/MODE-B.md B5): the same volume must also fit beside the installed port ROM's
+# kernel (50 040 856 B) and ramdisk (35 151 423 B) and the firmware in boot_b: 107.7 MiB are left there. The files take
+# 65 887 336 B (62.8 MiB); 96 keeps 33 MiB inside the volume and about 11 MiB of boot_b free for a larger kernel.
+size_mib = 96
 loader = "firmware"
 title = "Xiaomi Pad 6 (iPadOS 17.7.11)"
 dram_size = "0x200000000"
