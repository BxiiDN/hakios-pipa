diff --git a/scripts/unixnu/dualboot.py b/scripts/unixnu/dualboot.py
new file mode 100644
index 0000000..b7e9200
--- /dev/null
+++ b/scripts/unixnu/dualboot.py
@@ -0,0 +1,29 @@
+"""Dual boot with Android: the payload's menu made Android-first.
+
+board.toml [payload.dualboot] (all optional):
+  android_title   = "Android / HyperOS"
+  recovery_title  = "Recovery or Fastboot (hold Vol+ or Vol- while it restarts)"
+With the table present, the generated \\EFI\\UniXNU\\unixnu.toml gets an "android" entry first (action reset: the
+stock bootloader then starts Android as on any power-on, since the boot image was only RAM-booted), becomes the
+default, so the countdown ([payload] timeout) ends in Android; the OS entries keep their order after it, then a
+recovery entry (also a reset, for the user to hold a key), then Restart and Power off as before.
+Without the table nothing changes.
+"""
+import json
+
+
+def apply_dual_boot(config, dualboot):
+    if not dualboot:
+        return config
+    if 'default = "xnu"\n' not in config or '[[entry]]\nid = "reset"\n' not in config:
+        raise ValueError('dual boot: the payload menu is not in the form this change knows')
+    android = (f'[[entry]]\nid = "android"\ntitle = {json.dumps(dualboot.get("android_title", "Android / HyperOS"))}\n'
+               'type = "action"\naction = "reset"\n')
+    recovery = (f'[[entry]]\nid = "recovery"\n'
+                f'title = {json.dumps(dualboot.get("recovery_title", "Recovery or Fastboot (hold Vol+ or Vol- while it restarts)"))}\n'
+                'type = "action"\naction = "reset"\n')
+    config = config.replace('default = "xnu"\n', 'default = "android"\n', 1)
+    first = config.index('[[entry]]\n')
+    config = config[:first] + android + config[first:]
+    reset = config.index('[[entry]]\nid = "reset"\n')
+    return config[:reset] + recovery + config[reset:]
