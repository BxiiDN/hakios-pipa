# U-Boot profile of the Xiaomi Pad 6 for hakios-uefi (HAKIOS_PROFILE_ROOT=<this repo>/uefi-profiles).
# scripts/build-uboot.sh writes configs/xiaomi_pipa_defconfig into a copy of this overlay at build time from the
# pinned U-Boot's qcom_defconfig + board/qualcomm/qcom-phone.config + pipa.config here; it is never committed.
UBOOT_DEFCONFIG=xiaomi_pipa_defconfig
FIRMWARE_DIR=pipa
PROFILE_DTB=uefi/device-tree.dtb
