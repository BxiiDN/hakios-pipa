+                   # the device package (package/ of the port) sits in the tree at kits/<device>/
+                   next(ROOT.glob('kits/*/PipaVerifiedRootSelfTest.c'))):
         destination = out / (source.stem + '.o')
         arguments, command, index = record['arguments'], [], 0
         while index < len(arguments):   # XNU's own compile record, its warning flags replaced by ours
diff --git a/tests/pipa-verified-root-selftest-host.c b/tests/pipa-verified-root-selftest-host.c
new file mode 100644
index 0000000..e39d106
--- /dev/null
+++ b/tests/pipa-verified-root-selftest-host.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Host test of package/PipaVerifiedRootSelfTest.c with the real kit and an OpenSSL crypto provider (RSA-3072 PKCS#1 v1.5
+ * over SHA-256, as kits/VerifiedRoot/tools/manifest.py signs).
+ *   cc -DPIPA_SELFTEST_HOST -I kits/VerifiedRoot/include package/PipaVerifiedRootSelfTest.c \
+ *      kits/VerifiedRoot/src/verified_root.c tests/pipa-verified-root-selftest-host.c -lcrypto
+ *   ./a.out trusted-key.bin OS/manifest.bin SystemOS/manifest.bin      (exit 0 = the self-test reports PASS) */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <openssl/evp.h>
+#include <openssl/rsa.h>
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/param_build.h>
+#include "verified_root.h"
+
+struct pipa_root_policy { const uint8_t *manifest; uint64_t bytes; };
+uint8_t verified_root_key[VR_KEY_BYTES];
+struct pipa_root_policy verified_root_policies[4];
+uint64_t verified_root_policy_count;
+extern volatile uint32_t pipa_verified_root_selftest[8];
+void native_verified_root_probe(void);
+
+static int sha256(const void *p, size_t n, uint8_t out[32]) { unsigned len = 0; return EVP_Digest(p, n, out, &len, EVP_sha256(), NULL) && len == 32; }
+static int rsa(const uint8_t key[VR_KEY_BYTES], const uint8_t digest[32], const uint8_t sig[VR_SIGNATURE_BYTES])
+{
+    if (memcmp(key, "VROOTKEY", 8)) return 0;
+    BIGNUM *n = BN_bin2bn(key + 8, 384, NULL), *e = BN_bin2bn(key + 392, 3, NULL);
+    OSSL_PARAM_BLD *b = OSSL_PARAM_BLD_new(); OSSL_PARAM_BLD_push_BN(b, OSSL_PKEY_PARAM_RSA_N, n); OSSL_PARAM_BLD_push_BN(b, OSSL_PKEY_PARAM_RSA_E, e);
+    OSSL_PARAM *params = OSSL_PARAM_BLD_to_param(b); EVP_PKEY_CTX *c = EVP_PKEY_CTX_new_from_name(NULL, "RSA", NULL); EVP_PKEY *k = NULL;
+    EVP_PKEY_fromdata_init(c); EVP_PKEY_fromdata(c, &k, EVP_PKEY_PUBLIC_KEY, params);
+    EVP_PKEY_CTX *v = EVP_PKEY_CTX_new(k, NULL); int ok = EVP_PKEY_verify_init(v) == 1 && EVP_PKEY_CTX_set_rsa_padding(v, RSA_PKCS1_PADDING) == 1
+        && EVP_PKEY_CTX_set_signature_md(v, EVP_sha256()) == 1 && EVP_PKEY_verify(v, sig, VR_SIGNATURE_BYTES, digest, 32) == 1;
+    EVP_PKEY_CTX_free(v); EVP_PKEY_free(k); EVP_PKEY_CTX_free(c); OSSL_PARAM_free(params); OSSL_PARAM_BLD_free(b); BN_free(n); BN_free(e);
+    return ok;
+}
+const struct vr_crypto vr_xnu_crypto = {sha256, rsa};
+
+static uint8_t *slurp(const char *path, size_t *n) { FILE *f = fopen(path, "rb"); if (!f) { perror(path); exit(2); }
+    fseek(f, 0, SEEK_END); *n = (size_t)ftell(f); rewind(f); uint8_t *p = malloc(*n); if (fread(p, 1, *n, f) != *n) exit(2); fclose(f); return p; }
+
+int main(int argc, char **argv)
+{
+    if (argc < 3 || argc > 6) { fprintf(stderr, "usage: %s trusted-key.bin manifest.bin...\n", argv[0]); return 2; }
+    size_t n; uint8_t *k = slurp(argv[1], &n); if (n != VR_KEY_BYTES) return 2; memcpy(verified_root_key, k, n);
+    for (int i = 2; i < argc; i++) { verified_root_policies[i - 2].manifest = slurp(argv[i], &n); verified_root_policies[i - 2].bytes = n; }
+    verified_root_policy_count = (uint64_t)(argc - 2);
+    native_verified_root_probe();
+    return pipa_verified_root_selftest[6] ? 0 : 1;
+}
