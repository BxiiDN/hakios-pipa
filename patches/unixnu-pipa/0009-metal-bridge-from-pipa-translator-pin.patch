+#!/usr/bin/env python3
+"""Build pipa's native Metal bridge (drivers/AdrenoMetal/bridge/NativeMetalBridge.rs) as a static library.
+
+This device copy replaces UniXNU's script, which now pins metal2vulkan 555b13d5 with one consolidated patch. pipa's
+drivers/AdrenoMetal (the frontend the pipa kernel's GPU and display drivers were built against) carries its own 21-patch
+series, which applies, in name order and each on the tree the previous ones leave, to metal2vulkan 720ef1ce (UniXNU's
+first translator pin) and to no later pin. The bridge is therefore built from exactly that revision plus that series.
+
+The runtime's example library (runtime_examples.ll) and its function-constant fixture are assembled to AIR with llvm-as
+and embedded for the self-tests (NativeMetalBridge.rs reads NMB_FIXTURE_AIR, NativeMetalObjects.rs NMB_FC_AIR and
+NMB_RUNTIME_ID). Output: build/adreno-metal-bridge/<target>/libadreno_metal_bridge.a
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+PIN = '720ef1ce9ae2a2068999a8675717418b9416283e'
+SOURCE = ROOT / '.cache/gpu-reference/metal2vulkan'
+parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+parser.add_argument('--target', choices=['ios', 'host'], default='ios')
+parser.add_argument('--source', type=Path, default=SOURCE)
+args = parser.parse_args()
+SOURCE = args.source.resolve()
+if subprocess.check_output(['git', '-C', str(SOURCE), 'rev-parse', 'HEAD'], text=True).strip() != PIN:
+    raise SystemExit(f'{SOURCE}: translator revision is not {PIN}')
+PATCHES = sorted((ROOT / 'drivers/AdrenoMetal/bridge/patches').glob('*.patch'))
+if len(PATCHES) != 21:
+    raise SystemExit(f'expected pipa\'s 21 bridge patches, found {len(PATCHES)}')
+
+
+def git_tree(*steps):
+    """The source tree a scratch index holds after HEAD and the given commands, without touching the source's index."""
+    index = ROOT / 'build/adreno-metal-bridge-index'
+    index.parent.mkdir(parents=True, exist_ok=True)
+    env = dict(os.environ, GIT_INDEX_FILE=str(index))
+    subprocess.run(['git', '-C', str(SOURCE), 'read-tree', 'HEAD'], env=env, check=True)
+    for step in steps:
+        subprocess.run(['git', '-C', str(SOURCE)] + step, env=env, check=True)
+    tree = subprocess.check_output(['git', '-C', str(SOURCE), 'write-tree'], env=env, text=True).strip()
+    index.unlink()
+    return tree
+
+
+# The tree after each prefix of the series; the checkout must be one of them (fresh, or already partly or fully patched).
+states = [git_tree(*[['apply', '--cached', str(patch)] for patch in PATCHES[:count]]) for count in range(len(PATCHES) + 1)]
+current = git_tree(['add', '-A'])
+if current not in states:
+    raise SystemExit('Translator source differs from the pinned revision plus pipa\'s recorded patches')
+for patch in PATCHES[states.index(current):]:
+    subprocess.run(['git', '-C', str(SOURCE), 'apply', str(patch)], check=True)
+if git_tree(['add', '-A']) != states[-1]:
+    raise SystemExit('Translator patch result differs from its exact recorded source')
+
+out = ROOT / 'build/adreno-metal-bridge'
+out.mkdir(parents=True, exist_ok=True)
+llvm_as = next((p for p in [os.environ.get('LLVM_AS', ''), '/opt/homebrew/opt/llvm/bin/llvm-as', '/usr/local/opt/llvm/bin/llvm-as',
+                            shutil.which('llvm-as') or ''] if p and Path(p).exists()), None)
+if not llvm_as:
+    raise SystemExit('llvm-as is required to assemble the runtime fixture')
+air = out / 'runtime_examples.air'
+subprocess.run([llvm_as, '-o', air, SOURCE / 'crates/metal2vulkan-validation/fixtures/public/examples/runtime_examples.ll'],
+               check=True)
+fc_air = out / 'function_constant.air'
+subprocess.run([llvm_as, '-o', fc_air, SOURCE / 'crates/metal2vulkan-validation/fixtures/public/kernel_function_constant_gate_fold.ll'],
+               check=True)
+manifest = out / 'Cargo.toml'
+manifest.write_text('\n'.join([
+    '[package]', 'name = "adreno-metal-bridge"', 'version = "0.1.0"', 'edition = "2024"', 'rust-version = "1.98"', '[workspace]',
+    '[lib]', 'crate-type = ["staticlib"]', 'path = ' + json.dumps(str(ROOT / 'drivers/AdrenoMetal/bridge/NativeMetalBridge.rs')),
+    '[dependencies]',
+    'metal2vulkan = { path = ' + json.dumps(str(SOURCE / 'crates/metal2vulkan')) + ', features = ["ash"] }',
+    'metal2vulkan-runtime = { path = ' + json.dumps(str(SOURCE / 'crates/metal2vulkan-runtime')) + ' }',
+    'libc = "0.2"',
+    'sha2 = { version = "0.10", features = ["asm"] }',
+    '[profile.release]', 'panic = "unwind"', 'debug = 1', 'lto = "fat"', 'codegen-units = 1', '',
+]))
+triple = {'ios': 'aarch64-apple-ios', 'host': 'aarch64-apple-darwin'}[args.target]
+runtime_id = hashlib.sha256((PIN + '\n' + states[-1]).encode()).hexdigest()[:32]
+env = dict(os.environ, NMB_RUNTIME_ID=runtime_id, NMB_FIXTURE_AIR=str(air), NMB_FC_AIR=str(fc_air), IPHONEOS_DEPLOYMENT_TARGET='17.0',
+           MACOSX_DEPLOYMENT_TARGET='14.0')
+target_dir = ROOT / 'build/m2v-target'
+log = out / f'build-{args.target}.log'
+with log.open('w') as stream:
+    result = subprocess.run(['cargo', '+1.98.0', 'build', '--release', '--manifest-path', manifest, '--target', triple,
+                             '--target-dir', target_dir], env=env, stdout=stream, stderr=subprocess.STDOUT, timeout=7200)
+if result.returncode:
+    raise SystemExit(log.read_text()[-6000:])
+final = out / args.target / 'libadreno_metal_bridge.a'
+final.parent.mkdir(exist_ok=True)
+shutil.copyfile(target_dir / triple / 'release/libadreno_metal_bridge.a', final)
+print(f'PASS: pipa Metal bridge for {args.target} ({final.stat().st_size} bytes); translator {PIN[:12]} + {len(PATCHES)} patches')
