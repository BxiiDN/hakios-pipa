+/** @file
+  "GPT (read only)" in UniXNU's Tools menu: every whole disk's GPT, summarised on the panel and in the firmware log, so the
+  owner can see whether UFS LUN 0 has room for an `ipados` partition (hakios-pipa docs/IPADOS-PARTITION.md, design A)
+  without any change to the disk.
+
+  Read only by construction: the only storage call is EFI_BLOCK_IO_PROTOCOL.ReadBlocks (primary header at LBA 1, its entry
+  array, the backup header at the last LBA) on handles whose media is not a logical partition. No WriteBlocks, FlushBlocks,
+  Disk I/O or file system protocol is used (tests/test_gpt_view.py checks the source). The disk holding a partition named
+  "userdata" is shown as LUN 0, the way Android names it on pipa (sda34).
+
+  Copyright (c) 2026, hakios-pipa contributors.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/UniXNUMenuPlugin.h>
+
+#include "GptFont.h"
+#include "GptScan.h"
+
+// tools/gpt_capacity.py need: root 9 457 106 944 + guard 4 MiB + Data window 8 590 200 832 + log reserve 1 GiB
+#define GPT_VIEW_NEED_BYTES  19126026240ULL
+#define GPT_VIEW_MAX_DISKS   16
+#define GPT_VIEW_LINE_CHARS  96
+
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL  mBackground = { 0x00, 0x00, 0x00, 0x00 };
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL  mForeground = { 0xE0, 0xE0, 0xE0, 0x00 };
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL  mAccent     = { 0x40, 0xD0, 0xFF, 0x00 };
+
+STATIC
+GS_U32
+Crc32 (
+  IN CONST VOID  *Data,
+  IN GS_U64      Length
+  )
+{
+  UINT32  Value;
+
+  Value = 0;
+  if (EFI_ERROR (gBS->CalculateCrc32 ((VOID *)Data, (UINTN)Length, &Value))) {
+    return 0;
+  }
+  return Value;
+}
+
+STATIC
