+#!/usr/bin/env python3
+"""Check the assumptions PipaBacklightAttach.cpp makes about ShengBacklight's vtable in the built object:
+entry 2 + 7 is ShengBacklight::getMetaClass() and the vtable length equals kShengBacklightVtableEntries.
+Usage: check-pipa-backlight-vtable.py PipaBacklightService.late.o [expected-entries]"""
+import re, subprocess, sys
+
+obj = sys.argv[1]
+syms = subprocess.run(['llvm-nm', '-n', '--defined-only', obj], capture_output=True, text=True, check=True).stdout.split('\n')
+rows = [(int(a, 16), t, n) for a, t, n in (l.split(None, 2) for l in syms if len(l.split(None, 2)) == 3)]
+vt = next(r for r in rows if r[2] == '__ZTV14ShengBacklight')
+nxt = min((r[0] for r in rows if r[0] > vt[0] and r[1].lower() == vt[1].lower()), default=None)
+relocs = subprocess.run(['llvm-objdump', '--macho', '-r', obj], capture_output=True, text=True, check=True).stdout
+heads = subprocess.run(['llvm-objdump', '--macho', '--section-headers', obj], capture_output=True, text=True, check=True).stdout
+# the first DATA __const section holds the vtable; relocation addresses are relative to its start
+addr = next(int(p[3], 16) for p in (l.split() for l in heads.split('\n')) if len(p) >= 5 and p[1] == '__const' and p[4] == 'DATA')
+entries, inside = {}, False
+for line in relocs.split('\n'):
+    if line.startswith('Relocation information'):
+        inside = line.startswith('Relocation information (__DATA,__const)')
+        continue
+    m = re.match(r'([0-9a-f]{8})\s.*\s(\S+)$', line)
+    if inside and m: entries[int(m.group(1), 16)] = m.group(2)
+base = vt[0] - addr
+size = (nxt - vt[0]) // 8 if nxt else None
+slot = entries.get(base + 8 * 9)
+want = int(sys.argv[2]) if len(sys.argv) > 2 else None
+print(f'vtable entries: {size}, slot 2+7: {slot}')
+ok = slot == '__ZNK14ShengBacklight12getMetaClassEv' and size is not None and (want is None or size == want)
+print('OK' if ok else 'MISMATCH'); sys.exit(0 if ok else 1)
