diff --git a/board.toml b/board.toml
index 049a247..6346479 100644
--- a/board.toml
+++ b/board.toml
@@ -29,9 +29,10 @@ unixnu = "../UniXNU"
 "ipados-17.7.11-21H461" = "pipa_defconfig"
 
 [components]
+# stage A (hakios-pipa docs/BOOTSTRAP.md): ShengHidInput is not selected, so archive_plan does not require its entry
 # Native platform mainline components aligned with UniXNU component catalog. QcomGeniSpi and ShengNovatekTouch are the pipa
 # touch transport and protocol; the Wi-Fi/Bluetooth components stay listed but their boot arguments are default-off below.
-include = ["XnuPrelink", "DarwinBoot", "ArmDTPlatform", "ArmCpu", "SoftwareAES", "RamBlock", "VirtioMmioBlock", "VerifiedRoot", "ShengUfs", "GopFramebuffer", "AppleKeyStoreState", "ShengHidInput", "AdrenoPM4", "AdrenoFirmware", "ArmSmmu4K", "AirNir", "Ath12kWifi", "QcaBluetooth", "QcomGeniSpi", "ShengNovatekTouch"]
+include = ["XnuPrelink", "DarwinBoot", "ArmDTPlatform", "ArmCpu", "SoftwareAES", "RamBlock", "VirtioMmioBlock", "VerifiedRoot", "ShengUfs", "GopFramebuffer", "AppleKeyStoreState", "AdrenoPM4", "AdrenoFirmware", "ArmSmmu4K", "AirNir", "Ath12kWifi", "QcaBluetooth", "QcomGeniSpi", "ShengNovatekTouch"]
 
 [ipsw]
 url = "https://updates.cdn-apple.com/2025SpringFCS/fullrestores/122-77166/DCA6CFE8-90E9-4B92-880D-3DE171798E40/iPad_Pro_HFR_17.7.11_21H461_Restore.ipsw"
@@ -74,7 +75,7 @@ archives = [
   "build-verified-root-key.py",
   "component:ShengUfs",
   "component:AppleKeyStoreState",
-  "component:ShengHidInput",
+  # stage A (hakios-pipa docs/BOOTSTRAP.md): no ShengHidInput -- its ABI builder qualifies against a prelinked kernel
   "build-libpthread-kernel.py",
   "build-corecrypto-14.py",
   "build-corecrypto-14.py --namespace",
@@ -83,7 +84,7 @@ archives = [
   "build-boot-progress.py",
   "build-adreno650.py",
   "build-pipa-gpu-addon.py",
-  "build-gop-legacy-display.py",
+  # stage A: no NativeLegacyDisplay archive -- it links ShengHidInput and copies the previous kernel as its reference
   "check-pipa.py",
 ]
 
diff --git a/configs/pipa_defconfig b/configs/pipa_defconfig
index 56c6308..8643e25 100644
--- a/configs/pipa_defconfig
+++ b/configs/pipa_defconfig
@@ -1,3 +1,9 @@
+# STAGE A REFERENCE KERNEL (hakios-pipa docs/BOOTSTRAP.md) -- never a boot candidate. Off here: the legacy display
+# archive (it needs a prelinked kernel), and the storage/owner-root chain: VirtioMmioBlock and RamBlock link against the
+# original IOBlockStorageDevice through build/storage-abi/interface-audit.json, which no script of UniXNU 62f203c can
+# produce (it needs a live QEMU/gdb observation), and UFS, boot progress and the owner chain require them. The HID,
+# Adreno is off too: NativeAdrenoPublish imports native_gop_handoff_call/_memory from the legacy display archive.
+# display and PMGR references read only original-kext addresses and native IOService symbols, which this kernel has.
 # Xiaomi Pad 6 (pipa, SM8250-AC) defconfig for iPadOS 17.7.11 (21H461).
 # Mainline configuration: ArmDTPlatform + ArmCpu + SoftwareAES + RamBlock + ShengUfs + VerifiedRoot + Display + Adreno 650 +
 # BootProgress + PMGR. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
@@ -15,30 +21,30 @@ CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
 CONFIG_XNU_DT_PANIC_REGION=y
 CONFIG_XNU_NATIVE_ARCH_TIMER=y
 CONFIG_XNU_NATIVE_PAN=y
-CONFIG_XNU_NATIVE_UFS=y
-CONFIG_XNU_NATIVE_ADRENO=y
+CONFIG_XNU_NATIVE_UFS=n
+CONFIG_XNU_NATIVE_ADRENO=n
 CONFIG_XNU_NATIVE_ADRENO_ARCHIVE="{tree}/build/adreno650/libAdreno650.a"
 CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
-CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
-CONFIG_XNU_BOOT_PROGRESS=y
-CONFIG_XNU_BOOT_PROGRESS_STANDALONE=y
-CONFIG_XNU_NATIVE_RAM_BLOCK=y
+CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
+CONFIG_XNU_BOOT_PROGRESS=n
+CONFIG_XNU_BOOT_PROGRESS_STANDALONE=n
+CONFIG_XNU_NATIVE_RAM_BLOCK=n
 # The Verified variant of the virtio block device: its root authorization query is what the owner chain calls. No virtio
 # device exists on pipa, so its own block transport never configures.
-CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
+CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
 CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified/libVirtioMmioBlock.a"
 CONFIG_XNU_SHENG_PMGR=y
 # Owner root chain: audit/trust the verified root, mount the SystemOS cryptex as the cache carrier, publish the boot
 # manifest, then mount the persistent Data volume on UFS.
-CONFIG_XNU_VERIFIED_ROOT_PROBE=y
+CONFIG_XNU_VERIFIED_ROOT_PROBE=n
 CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-key/libVerifiedRootKey.a"
-CONFIG_XNU_OWNER_DATA_MOUNT=y
+CONFIG_XNU_OWNER_DATA_MOUNT=n
 CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
 CONFIG_XNU_OWNER_DATA_VOLUME_UUID="73F1FA24-4189-446D-96D4-FB6324EBE955"
-CONFIG_XNU_OWNER_ROOT_AUDIT=y
-CONFIG_XNU_OWNER_ROOT_TRUST=y
-CONFIG_XNU_OWNER_CACHE_MOUNT=y
-CONFIG_XNU_OWNER_CACHE_STARTUP=y
-CONFIG_XNU_OWNER_BOOT_MANIFEST=y
-CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
+CONFIG_XNU_OWNER_ROOT_AUDIT=n
+CONFIG_XNU_OWNER_ROOT_TRUST=n
+CONFIG_XNU_OWNER_CACHE_MOUNT=n
+CONFIG_XNU_OWNER_CACHE_STARTUP=n
+CONFIG_XNU_OWNER_BOOT_MANIFEST=n
+CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
 CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
