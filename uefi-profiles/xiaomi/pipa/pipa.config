# Xiaomi Pad 6 (pipa): what this board changes on top of qcom_defconfig and qcom-phone.config.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8250-xiaomi-pipa"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/xiaomi/pipa.env"
# HakiOS: the loader command and its USB transport (hakios-uefi u-boot/patches/hakios.patch)
CONFIG_CMD_HAKIOS=y
CONFIG_CMD_BOOTEFI=y
CONFIG_EFI_HAKIOS_USB_DEVICE=y
CONFIG_CMD_BOOTMENU=y
# Safety: no command in this image can write the tablet's storage through fastboot or USB mass storage.
# (pipa is UFS; U-Boot's fastboot has no UFS backend anyway, and UMS would expose LUN 0 read-write to the PC.)
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
