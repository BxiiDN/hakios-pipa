+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Pixel;
+
+  Pixel = mBackground;
+  Gop->Blt (Gop, &Pixel, EfiBltVideoFill, 0, 0, R->X, R->Y, R->Width, R->Height, 0);
+}
+
+// One ASCII line at (X, Y), clipped to the content rectangle; returns the height drawn.
+STATIC
+UINTN
+DrawLine (
+  IN EFI_GRAPHICS_OUTPUT_PROTOCOL         *Gop,
+  IN CONST UNIXNU_PLUGIN_RECT             *R,
+  IN UINTN                                Y,
+  IN CONST CHAR8                          *Text,
+  IN UINTN                                Scale,
+  IN EFI_GRAPHICS_OUTPUT_BLT_PIXEL        Color
+  )
+{
+  UINTN                          Len;
+  UINTN                          Cw;
+  UINTN                          Ch;
+  UINTN                          W;
+  UINTN                          Index;
+  UINTN                          Row;
+  UINTN                          Col;
+  UINTN                          Sy;
+  UINTN                          Sx;
+  CONST UINT8                    *Glyph;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  *Buffer;
+
+  Cw  = GPT_VIEW_GLYPH_WIDTH * Scale;
+  Ch  = GPT_VIEW_GLYPH_HEIGHT * Scale;
+  Len = AsciiStrLen (Text);
+  if ((Y + Ch > R->Y + R->Height) || (Len == 0)) {
+    return Ch;
+  }
+  Len = MIN (Len, R->Width / Cw);
+  W   = Len * Cw;
+  if (W == 0) {
+    return Ch;
+  }
+  Buffer = AllocatePool (W * Ch * sizeof (*Buffer));
+  if (Buffer == NULL) {
+    return Ch;
+  }
+  for (Index = 0; Index < W * Ch; Index++) {
+    Buffer[Index] = mBackground;
+  }
+  for (Index = 0; Index < Len; Index++) {
+    CHAR8  C = Text[Index];
+
+    Glyph = gGptViewGlyphs[((C >= 0x20) && (C <= 0x7E)) ? (C - 0x20) : ('?' - 0x20)];
+    for (Row = 0; Row < GPT_VIEW_GLYPH_HEIGHT; Row++) {
+      for (Col = 0; Col < GPT_VIEW_GLYPH_WIDTH; Col++) {
+        if ((Glyph[Row] & (0x80 >> Col)) == 0) {
+          continue;
+        }
+        for (Sy = 0; Sy < Scale; Sy++) {
+          for (Sx = 0; Sx < Scale; Sx++) {
+            Buffer[(Row * Scale + Sy) * W + Index * Cw + Col * Scale + Sx] = Color;
+          }
+        }
+      }
+    }
+  }
+  Gop->Blt (Gop, Buffer, EfiBltBufferToVideo, 0, 0, R->X, Y, W, Ch, 0);
+  FreePool (Buffer);
+  return Ch;
+}
+
+// ReadBlocks into a buffer aligned as the media asks; NULL when the read fails.
+STATIC
+UINT8 *
+ReadAligned (
+  IN  EFI_BLOCK_IO_PROTOCOL  *BlockIo,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  Bytes,
+  OUT VOID                   **Allocation
+  )
+{
+  UINTN  Align;
+  UINT8  *Raw;
+  UINT8  *Buf;
+
+  Align = MAX (BlockIo->Media->IoAlign, 1);
+  Raw   = AllocateZeroPool (Bytes + Align);
+  if (Raw == NULL) {
+    return NULL;
+  }
+  Buf = (UINT8 *)ALIGN_POINTER (Raw, Align);
+  if (EFI_ERROR (BlockIo->ReadBlocks (BlockIo, BlockIo->Media->MediaId, Lba, Bytes, Buf))) {
+    FreePool (Raw);
+    return NULL;
+  }
+  *Allocation = Raw;
+  return Buf;
+}
+
+STATIC
+VOID
+ScanDisk (
+  IN  EFI_BLOCK_IO_PROTOCOL  *BlockIo,
+  OUT GPT_SCAN_SUMMARY       *Summary
+  )
+{
+  UINT32  BlockSize;
+  UINT64  Blocks;
+  VOID    *HeaderAlloc;
+  VOID    *EntriesAlloc;
+  VOID    *BackupAlloc;
+  UINT8   *Header;
+  UINT8   *Entries;
+  UINT8   *Backup;
+  UINTN   EntryBytes;
+
+  BlockSize = BlockIo->Media->BlockSize;
+  Blocks    = BlockIo->Media->LastBlock + 1;
+  ZeroMem (Summary, sizeof (*Summary));
+  Header = ReadAligned (BlockIo, 1, BlockSize, &HeaderAlloc);
+  if (Header == NULL) {
+    Summary->Flags      = GPT_SCAN_NO_SIGNATURE;
+    Summary->BlockSize  = BlockSize;
+    Summary->DiskBlocks = Blocks;
+    return;
+  }
+  if (GptScanHeader (Header, BlockSize, Blocks, Crc32, Summary) & (GPT_SCAN_NO_SIGNATURE | GPT_SCAN_BAD_HEADER)) {
+    FreePool (HeaderAlloc);
+    return;
+  }
+  FreePool (HeaderAlloc);
+  EntryBytes = (UINTN)((((UINT64)Summary->EntryCount * Summary->EntrySize) + BlockSize - 1) / BlockSize * BlockSize);
+  Entries    = ReadAligned (BlockIo, Summary->EntriesLba, EntryBytes, &EntriesAlloc);
+  Backup     = ReadAligned (BlockIo, Blocks - 1, BlockSize, &BackupAlloc);
+  if (Entries == NULL) {
+    Summary->Flags |= GPT_SCAN_BAD_ENTRIES;
+  } else {
+    GptScanEntries (Entries, EntryBytes, Backup, Crc32, Summary);
+    FreePool (EntriesAlloc);
+  }
+  if (Backup != NULL) {
+    FreePool (BackupAlloc);
+  }
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+GptViewRun (
+  IN UNIXNU_MENU_PLUGIN_PROTOCOL    *This,
+  IN EFI_GRAPHICS_OUTPUT_PROTOCOL   *Gop,
+  IN CONST UNIXNU_PLUGIN_RECT       *Content,
+  IN UNIXNU_MENU_PLUGIN_DRAW_STATUS DrawStatus
+  )
+{
+  EFI_STATUS             Status;
+  EFI_HANDLE             *Handles;
+  UINTN                  Count;
+  UINTN                  Index;
+  UINTN                  Shown;
+  UINTN                  Pass;
+  UINTN                  Y;
+  UINTN                  Scale;
+  UINTN                  Signaled;
+  EFI_INPUT_KEY          Key;
+  EFI_BLOCK_IO_PROTOCOL  *BlockIo;
+  GPT_SCAN_SUMMARY       *Summaries;
+  CHAR8                  Line[GPT_VIEW_LINE_CHARS];
+  unsigned               L;
+
+  if ((Gop == NULL) || (Content == NULL) || (Content->Width == 0) || (Content->Height == 0)) {
+    return EFI_INVALID_PARAMETER;
+  }
+  Fill (Gop, Content);
+  Scale = (Content->Width >= 72 * GPT_VIEW_GLYPH_WIDTH * 2) ? 2 : 1;
+  Y     = Content->Y;
+  Y    += DrawLine (Gop, Content, Y, "GPT (read only) -- nothing is written. Enter/Power: back", Scale, mAccent);
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiBlockIoProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    DrawLine (Gop, Content, Y, "no block devices", Scale, mForeground);
+    Count   = 0;
+    Handles = NULL;
+  }
+  Summaries = AllocateZeroPool (GPT_VIEW_MAX_DISKS * sizeof (*Summaries));
+  Shown     = 0;
+  for (Index = 0; (Summaries != NULL) && (Index < Count) && (Shown < GPT_VIEW_MAX_DISKS); Index++) {
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo)) ||
+        (BlockIo->Media == NULL) || BlockIo->Media->LogicalPartition || !BlockIo->Media->MediaPresent ||
+        (BlockIo->Media->BlockSize < 512) || (BlockIo->Media->BlockSize > 4096) || (BlockIo->Media->LastBlock < 64))
+    {
+      continue;
+    }
+    ScanDisk (BlockIo, &Summaries[Shown]);
+    if ((Summaries[Shown].Flags & GPT_SCAN_NO_SIGNATURE) == 0) {
+      Shown++;
+    }
+  }
+  // LUN 0 (the disk with userdata) first, in full; then one line for every other disk with a GPT
+  for (Pass = 0; Pass < 2; Pass++) {
+    for (Index = 0; Index < Shown; Index++) {
+      if ((Summaries[Index].HasUserdata != 0) != (Pass == 0)) {
+        continue;
+      }
+      for (L = 0; GptScanLine (&Summaries[Index], GPT_VIEW_NEED_BYTES, L, Line, sizeof (Line)); L++) {
+        DEBUG ((DEBUG_ERROR, "GPTVIEW: disk %u: %a\n", (UINT32)Index, Line));
+        if ((Pass == 0) || (L == 0)) {
+          Y += DrawLine (Gop, Content, Y, Line, Scale, (Pass == 0) && (L == 4) ? mAccent : mForeground);
+        }
+      }
+      if (Pass == 0) {
+        Y += GPT_VIEW_GLYPH_HEIGHT * Scale / 2;
+      }
+    }
+  }
+  if (DrawStatus != NULL) {
+    DrawStatus (This, 0, L"GPT survey: read only");
+  }
+  if (Summaries != NULL) {
+    FreePool (Summaries);
+  }
+  if (Handles != NULL) {
+    FreePool (Handles);
+  }
+  while (gST->ConIn != NULL) {
+    if (EFI_ERROR (gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &Signaled))) {
+      break;
+    }
+    if (EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+      continue;
+    }
+    if ((Key.UnicodeChar == CHAR_CARRIAGE_RETURN) || (Key.UnicodeChar == CHAR_LINEFEED) || (Key.ScanCode == SCAN_ESC)) {
+      break;
+    }
+  }
+  return EFI_SUCCESS;
+}
+
+STATIC UNIXNU_MENU_PLUGIN_PROTOCOL  mGptViewPlugin = {
+  UNIXNU_MENU_PLUGIN_PROTOCOL_SIGNATURE,
+  UNIXNU_MENU_PLUGIN_PROTOCOL_VERSION,
+  L"GPT (read only)",
+  GptViewRun
+};
+
+EFI_STATUS
+EFIAPI
+GptViewDxeEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  (VOID)SystemTable;
+  return gBS->InstallProtocolInterface (&ImageHandle, &gUniXNUMenuPluginProtocolGuid, EFI_NATIVE_INTERFACE, &mGptViewPlugin);
+}
