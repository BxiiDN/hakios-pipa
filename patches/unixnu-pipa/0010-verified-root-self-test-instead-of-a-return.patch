diff --git a/package/PipaVerifiedRootSelfTest.c b/package/PipaVerifiedRootSelfTest.c
new file mode 100644
index 0000000..e3e99e6
--- /dev/null
+++ b/package/PipaVerifiedRootSelfTest.c
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* native_verified_root_probe(): the owner-root self-test bsd_init runs with the boot-arg offline-owner-root-check=1.
+ * UniXNU's QEMU probe (scripts/qemu-entry/verified-root-probe.c) checks sample blocks against a full hash table embedded
+ * in the kernel; pipa embeds only the 544-byte header-only policies (the tables live in the root image, NativeUfs checks
+ * every read against them), so this self-test exercises what the kernel holds: each embedded policy must authenticate
+ * under the embedded owner anchor with the kernel's own RSA-3072/SHA-256 (vr_xnu_crypto), and every tampered variant
+ * must be refused. Results: pipa_verified_root_selftest[] and one log line. Reads and copies only; changes nothing. */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "verified_root.h"
+
+#ifdef PIPA_SELFTEST_HOST
+#include <stdio.h>
+#define SELFTEST_LOG printf
+#else
+extern int printf(const char *, ...);
+#define SELFTEST_LOG printf
+#endif
+
+struct pipa_root_policy { const uint8_t *manifest; uint64_t bytes; };
+extern const uint8_t verified_root_key[VR_KEY_BYTES];
+extern const struct pipa_root_policy verified_root_policies[];
+extern const uint64_t verified_root_policy_count;
+extern const struct vr_crypto vr_xnu_crypto;
+
+/* [0] policies, [1] authenticated, [2] tampered signatures refused, [3] tampered headers refused,
+ * [4] wrong keys refused, [5] wrong lengths refused, [6] 1 when every check held, [7] last failing policy + 1 */
+volatile uint32_t pipa_verified_root_selftest[8];
+
+static uint8_t copy[VR_HEADER_BYTES + VR_SIGNATURE_BYTES], key[VR_KEY_BYTES];
+
+void native_verified_root_probe(void)
+{
+    volatile uint32_t *r = pipa_verified_root_selftest;
+    struct vr_view view;   /* minimum generation 1: the kit refuses 0, and every pipa policy has generation >= 1 */
+    uint64_t n = verified_root_policy_count;
+    for (int i = 0; i < 8; i++) r[i] = 0;
+    r[0] = (uint32_t)n;
+    for (uint64_t i = 0; i < n; i++) {
+        const struct pipa_root_policy *p = &verified_root_policies[i];
+        int ok = p->bytes == sizeof(copy);
+        if (ok && vr_open_header(p->manifest, (size_t)p->bytes, verified_root_key, 1, &vr_xnu_crypto, &view) == VR_OK) r[1]++;
+        else ok = 0;
+        if (ok) {
+            memcpy(copy, p->manifest, sizeof(copy));
+            copy[VR_HEADER_BYTES + 17] ^= 0x01;                       /* one signature bit */
+            if (vr_open_header(copy, sizeof(copy), verified_root_key, 1, &vr_xnu_crypto, &view) == VR_SIGNATURE) r[2]++;
+            else ok = 0;
+            memcpy(copy, p->manifest, sizeof(copy));
+            copy[56] ^= 0x01;                                         /* one bit of the signed image digest */
+            if (vr_open_header(copy, sizeof(copy), verified_root_key, 1, &vr_xnu_crypto, &view) != VR_OK) r[3]++;
+            else ok = 0;
+            memcpy(key, verified_root_key, sizeof(key));
+            key[100] ^= 0x01;                                         /* another owner's modulus */
+            if (vr_open_header(p->manifest, (size_t)p->bytes, key, 1, &vr_xnu_crypto, &view) != VR_OK) r[4]++;
+            else ok = 0;
+            if (vr_open_header(p->manifest, (size_t)p->bytes - 1, verified_root_key, 1, &vr_xnu_crypto, &view) == VR_FORMAT) r[5]++;
+            else ok = 0;
+        }
+        if (!ok && !r[7]) r[7] = (uint32_t)(i + 1);
+    }
+    r[6] = n > 0 && r[1] == n && r[2] == n && r[3] == n && r[4] == n && r[5] == n;
+    SELFTEST_LOG("pipa owner-root self-test: %s (policies %u, authenticated %u, refused sig %u hdr %u key %u len %u)\n",
+                 r[6] ? "PASS" : "FAIL", r[0], r[1], r[2], r[3], r[4], r[5]);
+}
