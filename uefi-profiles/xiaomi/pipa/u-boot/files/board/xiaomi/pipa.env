# Xiaomi Pad 6 (pipa): the boot manager shown when this image is started with `fastboot boot`.
# Volume Up / Volume Down move, Power selects (CONFIG_BUTTON_REMAP_PHONE_KEYS). After bootmenu_delay seconds the
# default entry, Android, is taken. No entry writes to the tablet's storage.
bootdelay=0
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan
bootmenu_delay=10
bootmenu_default=0
bootcmd=bootmenu
bootmenu_0=Android / HyperOS (restart into Android; nothing is written)=reset
bootmenu_1=HakiOS (Darwin, from RAM)=if hakios load; then hakios boot; else echo No HakiOS payload in this image; pause; fi
bootmenu_2=Recovery or Fastboot (hold Vol+ or Vol- while it restarts)=pause Hold the key now and press Power to restart; reset
bootmenu_3=U-Boot shell=setenv bootretry -1
bootmenu_4=Board information=bdinfo; meminfo; pause
