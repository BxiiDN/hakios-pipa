-// Find the partition named "userdata" in LUN 0's primary GPT (4096-byte sectors), then read the
+// The partition the root image lives in. "userdata" unless the boot argument native-ufs-root-part names another one
+// (NativeUfs::start, before the first findRootLayout). hakios-pipa: Android keeps userdata; iPadOS gets its own partition.
+static char gRootPartitionName[36] = "userdata";
+
+// True when the root partition is Android's userdata: the persistent store and the log never open a write window then.
+static bool rootPartitionIsAndroidUserdata (void)
+{
+  return strcmp (gRootPartitionName, "userdata") == 0;
+}
+
