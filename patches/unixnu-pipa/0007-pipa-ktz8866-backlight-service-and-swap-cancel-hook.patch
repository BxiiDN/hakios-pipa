diff --git a/package/PipaBacklightAttach.cpp b/package/PipaBacklightAttach.cpp
new file mode 100644
index 0000000..d1f6944
--- /dev/null
+++ b/package/PipaBacklightAttach.cpp
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Late registration of the pipa AppleARMBacklight service (PipaBacklightService.cpp). Adapted from this repository's
+// TB-J716F BacklightProbe.cpp (removed in 421c34b). Off by default on pipa: sheng-backlight=1 enables it.
+// The service runs the class initializer between preModLoad/postModLoad of AppleARMPlatform and, with backlight-control
+// (sheng-backlight-control, default 1), answers getMetaClass() with Apple's AppleARMBacklight metaclass so that a match on
+// that class name finds it. The vtable slot and length are checked against the built object by scripts/check-pipa-backlight-vtable.py.
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOLib.h>
+#include <libkern/OSBase.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+
+extern "C" void sheng_backlight_static_init(void) __asm__("__GLOBAL__sub_I_PipaBacklightService.cpp");
+extern "C" void *shengxnu_backlight_create_instance(void);
+extern "C" const void *_ZTV14ShengBacklight[];
+extern "C" {
+volatile int sheng_backlight_probe_result = 0;
+volatile int sheng_backlight_probe_stage = 0;
+}
+
+namespace {
+
+static const OSMetaClass *gAppleBacklightMeta;
+constexpr size_t kShengBacklightVtableEntries = 171;
+static const void *gPatchedBacklightVtable[256];
+
+static const OSMetaClass *appleBacklightGetMetaClass(const OSObject *) {
+    return gAppleBacklightMeta;
+}
+
+static bool patchBacklightVtable(IOService *service) {
+    gAppleBacklightMeta = OSMetaClass::getMetaClassWithName(
+        OSSymbol::withCStringNoCopy("AppleARMBacklight"));
+    if (!gAppleBacklightMeta) return false;
+    // 171 = 2 header words + 169 virtual slots of ShengBacklight as built against this iPadOS 17 XNU (measured on the object by
+    // scripts/check-pipa-backlight-vtable.py). The TB-J716F code copied 189, which ran 18 words into the next vtable; the
+    // slots past the real end stay null here.
+    for (size_t i = 0; i < kShengBacklightVtableEntries; ++i) {
+        gPatchedBacklightVtable[i] = _ZTV14ShengBacklight[i];
+    }
+    gPatchedBacklightVtable[2 + 7] = reinterpret_cast<const void *>(&appleBacklightGetMetaClass);
+    *reinterpret_cast<const void ***>(service) = &gPatchedBacklightVtable[2];
+    return true;
+}
+
+} // namespace
+
+extern "C" void sheng_backlight_probe(void) {
+    static bool started = false;
+    if (started) return;
+    uint32_t enabled = 0;
+    PE_parse_boot_argn("sheng-backlight", &enabled, sizeof(enabled));
+    if (!enabled) return;
+    started = true;
+    sheng_backlight_probe_stage = 1;
+
+    void *handle = OSMetaClass::preModLoad("com.apple.driver.AppleARMPlatform");
+    if (!handle) {
+        sheng_backlight_probe_result = -1;
+        return;
+    }
+    sheng_backlight_static_init();
+    if (OSMetaClass::postModLoad(handle) != kIOReturnSuccess) {
+        sheng_backlight_probe_result = -2;
+        return;
+    }
+    sheng_backlight_probe_stage = 2;
+
+    IOService *platform = IOService::getPlatform();
+    if (!platform) {
+        sheng_backlight_probe_result = -3;
+        return;
+    }
+    IOService *service = static_cast<IOService *>(shengxnu_backlight_create_instance());
+    if (!service) {
+        sheng_backlight_probe_result = -4;
+        return;
+    }
+    uint32_t control = 1;
+    PE_parse_boot_argn("sheng-backlight-control", &control, sizeof(control));
+    if (control && !patchBacklightVtable(service)) {
+        service->release();
+        sheng_backlight_probe_result = -6;
+        return;
+    }
+    if (!service->attach(platform)) {
+        service->release();
+        sheng_backlight_probe_result = -5;
+        return;
+    }
+    sheng_backlight_probe_stage = 3;
+    if (!service->start(platform)) {
+        service->detach(platform);
+        service->release();
+        sheng_backlight_probe_result = -6;
+        return;
+    }
+    sheng_backlight_probe_stage = 4;
+    sheng_backlight_probe_result = 1;
+}
diff --git a/package/PipaBacklightService.cpp b/package/PipaBacklightService.cpp
new file mode 100644
index 0000000..0ae8114
--- /dev/null
+++ b/package/PipaBacklightService.cpp
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// AppleARMBacklight brightness service for the Xiaomi Pad 6 (pipa): publishes the interface CoreBrightness in backboardd
+// uses (IODisplayParameters brightness / BrightnessMilliNits / FadePeriod, backlight-control) and drives the panel's KTZ8866
+// backlight controller over I2C11 (BacklightProbe.c: pipa_ktz_open / pipa_ktz_write_level, verified on this unit in tests
+// 26v/27v). Adapted from this repository's TB-J716F AppleARMBacklight.cpp (removed in 421c34b), which scaled AMOLED pixels;
+// the pipa panel is an LCD, so pixels stay at full scale (native_backlight_scale, defined below, is 256) and only the LED current
+// changes. Level range 0..2047 = the KTZ8866's 11-bit BL_BRT. Off unless sheng-backlight=1.
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <kern/thread.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+#include <string.h>
+
+extern "C" {
+// [0] stage (1 init, 4 ready)
+// [1] current level (0..2047)
+// [2] target level (0..2047)
+// [3] brightness updates applied
+// [4] errors (0)
+// [5] setProperties calls from CoreBrightness (backboardd)
+// [6] last FadePeriod (ms)
+// [7] last level written to the KTZ8866
+volatile uint32_t native_backlight_stats[8];
+// The GOP presenter multiplies every pixel by native_backlight_scale/256 (NativeGOPPresenter.cpp). That scaling was the
+// TB-J716F AMOLED's brightness; on pipa's LCD brightness is the KTZ8866 LED current above, so the pixel factor is unity.
+volatile uint32_t native_backlight_scale = 256;
+int pipa_ktz_open(unsigned *level);
+int pipa_ktz_write_level(unsigned level);
+int pipa_ktz_read_level(unsigned *level);
+}
+
+namespace {
+
+constexpr uint32_t kMaxLevel = 2047;
+constexpr uint32_t kInitialLevel = 1009;   // replaced in start() by the level the bootloader left (read from the KTZ8866)
+constexpr uint32_t kMaxFadeMs = 2000;
+constexpr uint32_t kStepMs = 16;
+// Millinits range for iPadOS CoreBrightness: 2 nits min, 500 nits max
+constexpr int32_t kMinMilliNits = 2000;
+constexpr int32_t kMaxMilliNits = 500000;
+constexpr uint32_t kLmaxProduct = 500u << 16;   // 16.16 fixed-point nits
+constexpr uint32_t kLmidProduct = 140;
+constexpr uint32_t kLminProduct = 2;
+
+
+static bool extractU32(const OSObject *obj, uint32_t *out) {
+    if (!obj) return false;
+    if (const OSNumber *num = OSDynamicCast(OSNumber, obj)) {
+        *out = num->unsigned32BitValue();
+        return true;
+    }
+    if (const OSDictionary *dict = OSDynamicCast(OSDictionary, obj)) {
+        if (const OSNumber *val = OSDynamicCast(OSNumber, dict->getObject("value"))) {
+            *out = val->unsigned32BitValue();
+            return true;
+        }
+    }
+    return false;
+}
+
+static uint32_t nitsFixedToLevel(uint32_t fixed) {
+    int32_t nits = static_cast<int32_t>(fixed);
+    if (nits <= 0) return 0;
+    int64_t milli = (static_cast<int64_t>(nits) * 1000) >> 16;
+    if (milli <= kMinMilliNits) return 1;
+    if (milli >= kMaxMilliNits) return kMaxLevel;
+    return static_cast<uint32_t>(1 + (milli - kMinMilliNits) * (kMaxLevel - 1) / (kMaxMilliNits - kMinMilliNits));
+}
+
+static OSDictionary *makeRangeDict(int64_t minVal, int64_t maxVal, int64_t curVal) {
+    OSDictionary *dict = OSDictionary::withCapacity(3);
+    if (!dict) return nullptr;
+    OSNumber *nMin = OSNumber::withNumber(static_cast<uint64_t>(minVal), 64);
+    OSNumber *nMax = OSNumber::withNumber(static_cast<uint64_t>(maxVal), 64);
+    OSNumber *nVal = OSNumber::withNumber(static_cast<uint64_t>(curVal), 64);
+    if (nMin) { dict->setObject("min", nMin); nMin->release(); }
+    if (nMax) { dict->setObject("max", nMax); nMax->release(); }
+    if (nVal) { dict->setObject("value", nVal); nVal->release(); }
+    return dict;
+}
+
+} // namespace
+
+class ShengBacklight : public IOService {
+    OSDeclareDefaultStructors(ShengBacklight)
+
+private:
+    IOLock *fLock;
+    uint32_t fCurrent;
+    uint32_t fTarget;
+    uint32_t fSavedNonZero;
+    uint32_t fFadeStart;
+    uint32_t fFadeSteps;
+    uint32_t fFadeStep;
+    bool fEnabled;
+    bool fStopping;
+    uint32_t fWritten;
+
+    // Called with fLock held (or before the fade thread exists): the I2C transfers are serialised by it.
+    void applyLevel(uint32_t level) {
+        if (level > kMaxLevel) level = kMaxLevel;
+        if (level == fWritten) { fCurrent = level; native_backlight_stats[1] = level; return; }
+        if (pipa_ktz_write_level(level)) {
+            native_backlight_stats[4] = native_backlight_stats[4] + 1;
+            return;   // fCurrent unchanged: the fade loop retries on its next step
+        }
+        fWritten = level;
+        fCurrent = level;
+        if (level == fTarget) {
+            unsigned back = 0xffffffffu;
+            int rc = pipa_ktz_read_level(&back);
+            IOLog("[backlight] target %u written to KTZ8866 (writes %u), read back %u%s\n", level,
+                  native_backlight_stats[3] + 1, back, rc ? " (read failed)" : back == level ? " OK" : " MISMATCH");
+        }
+        native_backlight_stats[1] = level;
+        native_backlight_stats[7] = level;
+        native_backlight_stats[3] = native_backlight_stats[3] + 1;
+    }
+
+    void publishDisplayParameters(uint32_t level) {
+        OSDictionary *params = OSDictionary::withCapacity(3);
+        if (!params) return;
+        if (OSDictionary *br = makeRangeDict(0, kMaxLevel, level)) {
+            params->setObject("brightness", br);
+            br->release();
+        }
+        int64_t milli = level ? kMinMilliNits + static_cast<int64_t>(level) * (kMaxMilliNits - kMinMilliNits) / kMaxLevel : 0;
+        if (OSDictionary *nits = makeRangeDict(kMinMilliNits, kMaxMilliNits, milli)) {
+            params->setObject("BrightnessMilliNits", nits);
+            nits->release();
+        }
+        if (OSDictionary *fade = makeRangeDict(0, kMaxFadeMs, 0)) {
+            params->setObject("FadePeriod", fade);
+            fade->release();
+        }
+        setProperty("IODisplayParameters", params);
+        params->release();
+    }
+
+    static void fadeThreadMain(void *arg, wait_result_t) {
+        static_cast<ShengBacklight *>(arg)->fadeLoop();
+    }
+
+    void fadeLoop() {
+        for (;;) {
+            IOSleep(kStepMs);
+            if (!fLock) break;
+            IOLockLock(fLock);
+            if (fStopping) {
+                IOLockUnlock(fLock);
+                break;
+            }
+            if (fCurrent != fTarget) {
+                uint32_t next = fTarget;
+                if (fFadeSteps > 1 && fFadeStep + 1 < fFadeSteps) {
+                    ++fFadeStep;
+                    int32_t start = static_cast<int32_t>(fFadeStart);
+                    int32_t delta = static_cast<int32_t>(fTarget) - start;
+                    next = static_cast<uint32_t>(start + delta * static_cast<int32_t>(fFadeStep) / static_cast<int32_t>(fFadeSteps));
+                }
+                applyLevel(next);
+            }
+            IOLockUnlock(fLock);
+        }
+    }
+
+public:
+    bool init(OSDictionary *dict = nullptr) override {
+        if (!IOService::init(dict)) return false;
+        fLock = IOLockAlloc();
+        fCurrent = kInitialLevel;
+        fTarget = kInitialLevel;
+        fSavedNonZero = kInitialLevel;
+        fFadeStart = kInitialLevel;
+        fFadeSteps = 0;
+        fFadeStep = 0;
+        fEnabled = true;
+        fStopping = false;
+        fWritten = 0xffffffffu;
+        return fLock != nullptr;
+    }
+
+    void free() override {
+        if (fLock) {
+            IOLockFree(fLock);
+            fLock = nullptr;
+        }
+        IOService::free();
+    }
+
+    bool start(IOService *provider) override {
+        unsigned bootLevel = 0;
+        if (pipa_ktz_open(&bootLevel)) {
+            native_backlight_stats[4] = native_backlight_stats[4] + 1;
+            IOLog("[backlight] KTZ8866 not reachable; service not started\n");
+            return false;
+        }
+        if (!IOService::start(provider)) return false;
+        native_backlight_stats[0] = 1;
+        if (bootLevel > kMaxLevel) bootLevel = kMaxLevel;
+        fWritten = bootLevel;
+        fCurrent = fTarget = fFadeStart = bootLevel;
+        fSavedNonZero = bootLevel ? bootLevel : kInitialLevel;
+
+        setName("backlight");
+        setProperty("IONameMatch", "backlight");
+        setProperty("IONameMatched", "backlight");
+        // Grant backboardd (CoreBrightness) permission to call IORegistryEntrySetCFProperties on this service.
+        setProperty("NativeSandboxGrantProcess", "backboardd");
+
+        uint32_t control = 1;
+        PE_parse_boot_argn("sheng-backlight-control", &control, sizeof(control));
+        if (control) {
+            setProperty("backlight-control", kOSBooleanTrue);
+        }
+
+        const uint8_t zeroTable[32] = {};
+        if (OSData *data = OSData::withBytes(zeroTable, sizeof(zeroTable))) {
+            setProperty("backlight-marketing-table", data);
+            setProperty("backlight-calibration-parameters", data);
+            data->release();
+        }
+        const uint32_t lmax = kLmaxProduct;
+        if (OSData *data = OSData::withBytes(&lmax, sizeof(lmax))) {
+            setProperty("LmaxProduct", data);
+            data->release();
+        }
+        setProperty("LmidProduct", kLmidProduct, 32);
+        setProperty("LminProduct", kLminProduct, 32);
+
+        native_backlight_stats[1] = fCurrent;
+        native_backlight_stats[2] = fCurrent;
+        native_backlight_stats[7] = fCurrent;
+        publishDisplayParameters(fCurrent);
+
+        thread_t thread = THREAD_NULL;
+        if (kernel_thread_start(&ShengBacklight::fadeThreadMain, this, &thread) == KERN_SUCCESS) {
+            thread_deallocate(thread);
+        }
+
+        native_backlight_stats[0] = 4;
+        registerService();
+        IOLog("[backlight] AppleARMBacklight registered on the KTZ8866 (level=%u/%u)\n", fCurrent, kMaxLevel);
+        return true;
+    }
+
+    void stop(IOService *provider) override {
+        if (fLock) {
+            IOLockLock(fLock);
+            fStopping = true;
+            IOLockUnlock(fLock);
+        }
+        IOService::stop(provider);
+    }
+
+    IOReturn setProperties(OSObject *properties) override {
+        OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+        if (!dict) return kIOReturnBadArgument;
+
+        const OSDictionary *params = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+        const OSDictionary *source = params ? params : dict;
+
+        uint32_t fadeMs = 0;
+        extractU32(source->getObject("FadePeriod"), &fadeMs);
+        if (fadeMs > kMaxFadeMs) fadeMs = kMaxFadeMs;
+
+        uint32_t newLevel = 0;
+        bool hasLevel = false;
+        if (extractU32(source->getObject("brightness"), &newLevel)) {
+            if (newLevel > kMaxLevel) newLevel = kMaxLevel;
+            hasLevel = true;
+        } else {
+            uint32_t fixedNits = 0;
+            if (extractU32(source->getObject("brightness-nits"), &fixedNits) ||
+                extractU32(source->getObject("BrightnessMilliNits"), &fixedNits)) {
+                newLevel = nitsFixedToLevel(fixedNits);
+                hasLevel = true;
+            }
+        }
+
+        if (const OSBoolean *en = OSDynamicCast(OSBoolean, source->getObject("backlight-enable"))) {
+            fEnabled = en->isTrue();
+            if (!fEnabled) {
+                newLevel = 0;
+                hasLevel = true;
+            } else if (!hasLevel) {
+                newLevel = fSavedNonZero ? fSavedNonZero : kInitialLevel;
+                hasLevel = true;
+            }
+        }
+
+        if (!hasLevel) {
+            IOLog("[backlight] setProperties #%u from CoreBrightness without a level (fade %u ms)\n",
+                  native_backlight_stats[5] + 1, fadeMs);
+            native_backlight_stats[5] = native_backlight_stats[5] + 1;
+            return kIOReturnSuccess;
+        }
+        IOLog("[backlight] setProperties #%u: requested level %u (fade %u ms, current %u)\n", native_backlight_stats[5] + 1,
+              newLevel, fadeMs, fCurrent);
+
+        native_backlight_stats[5] = native_backlight_stats[5] + 1;
+        native_backlight_stats[6] = fadeMs;
+
+        IOLockLock(fLock);
+        if (newLevel > 0) {
+            fSavedNonZero = newLevel;
+        }
+        fTarget = newLevel;
+        native_backlight_stats[2] = newLevel;
+        uint32_t steps = fadeMs / kStepMs;
+        if (steps <= 1 || newLevel == fCurrent) {
+            fFadeSteps = 0;
+            fFadeStep = 0;
+            applyLevel(newLevel);
+        } else {
+            fFadeStart = fCurrent;
+            fFadeSteps = steps;
+            fFadeStep = 0;
+        }
+        IOLockUnlock(fLock);
+
+        publishDisplayParameters(newLevel);
+        return kIOReturnSuccess;
+    }
+};
+
+OSDefineMetaClassAndStructors(ShengBacklight, IOService)
+
+extern "C" void *shengxnu_backlight_create_instance(void) {
+    ShengBacklight *instance = new ShengBacklight;
+    if (!instance) return nullptr;
+    if (!instance->init()) {
+        instance->release();
+        return nullptr;
+    }
+    return instance;
+}
